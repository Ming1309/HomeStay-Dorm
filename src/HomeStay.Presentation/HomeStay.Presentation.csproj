<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HomeStay.BusinessLogic\HomeStay.BusinessLogic.csproj" />
    <ProjectReference Include="..\HomeStay.DataAccess\HomeStay.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClientApp/**" />
    <Content Remove="ClientApp/**" />
    <EmbeddedResource Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/**</DefaultItemExcludes>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

</Project>
