@startuml
title LAP PHIEU DANG KY - SO DO TUAN TU
hide footbox
autonumber
actor "Nhan vien Sale" as Sale
boundary RegistrationForm as UI
control PhieuDangKyController as API
control LapPhieuDangKy as UC
entity KhachHang as KH
entity PhieuDangKy as PDK
database PhienDuLieu as DB

Sale -> UI : Nhap va gui phieu dang ky
UI -> API : POST /api/registrations
API -> API : Lay MaNV tu JWT claim
alt Khong co MaNV claim
  API --> UI : 401 Unauthorized
else Co MaNV claim
  API -> UC : TaoPhieuDangKy(..., maNV)
  UC -> DB : BatDauGiaoDich()
  UC -> KH : KiemTraTonTai(soGiayTo)
  alt Khach hang chua ton tai
    UC -> KH : TaoMoi(...) + Them()
  end
  UC -> PDK : TaoMoi(..., thoiDiem)
  UC -> PDK : KiemTraDieuKien(thoiDiem)
  alt Du lieu hop le
    UC -> PDK : Them()
    UC -> DB : Commit()
    UC --> API : phieuDangKy
    API --> UI : 200 OK
  else Du lieu khong hop le / loi ghi
    UC -> DB : Rollback()
    API --> UI : 409 / 500
  end
end
@enduml
