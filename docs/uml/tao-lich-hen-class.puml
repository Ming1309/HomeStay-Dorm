@startuml
title TAO LICH HEN - SO DO LOP 3 TANG
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "TANG GIAO DIEN" {
  class SaleAppointmentPage <<boundary>>
  class LichHenController <<controller>> {
    +TaiDanhSachChungTu(type, keyword)
    +TaoLichHen(request)
    +SuaLichHen(id, request)
  }
}
package "TANG NGHIEP VU" {
  class TaoLichHen <<control>> {
    +TaiDanhSachChungTu(loai, tuKhoa)
    +LuuLichHen(loai, maChungTu, maCN, ngay, gio, maNV)
  }
  class LichHen <<entity>> {
    +TaoMoi(..., thoiDiemTao) : LichHen
    +KiemTraThoiGianHopLe(thoiDiemHienTai)
    +KiemTraHopLe() : Task
    +KiemTraTrungLich() : Task
    +Them() : Task
  }
}
package "TANG TRUY CAP DU LIEU" {
  class LichHenDB <<database>> {
    +Them(lichHen) : Task
    +KiemTraLichTrungCaNhanVien(...) : Task<bool>
  }
  class PhieuDangKyDB <<database>>
  class PhieuCocDB <<database>>
  class HopDongDB <<database>>
  class PhienDuLieu <<database>>
}

SaleAppointmentPage --> LichHenController : HTTP /api/appointments
LichHenController --> TaoLichHen : maNV tu JWT claim
TaoLichHen --> LichHen
TaoLichHen --> PhienDuLieu
TaoLichHen --> PhieuDangKyDB
TaoLichHen --> PhieuCocDB
TaoLichHen --> HopDongDB
LichHen --> LichHenDB
@enduml
