@startuml
title SO DO LOP 3 TANG - TAO LICH HEN
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHTaoLichHen #BFE8BA {
    - lstLoaiLichHen: ListBox
    - txtTimKiemChungTu: TextBox
    - grvDanhSachChungTu: GridView
    - lblMaChungTu: Label
    - lblHoTenKhachHang: Label
    - lblSoDienThoai: Label
    - lblPhong: Label
    - dtpNgayHen: DatePicker
    - txtGioHen: TimePicker
    - txtNhanVienPhuTrach: TextBox
    - txtChiNhanh: TextBox
    - btnLuuLichHen: Button
    --
    + HienThi()
    + TimChungTu(loai: String, tuKhoa: String)
    + LuuLichHen()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class TaoLichHen #F4E3A2 {
    + TaiDanhSachChungTu(loai: String, tuKhoa: String, maNV: String)
    + LuuLichHen(loai: String, maChungTu: String, ngayHen: Date, gioHen: TimeSpan, maNV: String)
  }
  class NhanVien #F4E3A2 {
    - MaNV: String
    - MaCN: String
    + DocPhamVi(maNV: String): NhanVien
  }
  class LichHen #F4E3A2 {
    - MaLH: String
    - MaCN: String
    - TrangThai: String
    + TaoMoi(loai: String, maChungTu: String, maCN: String, ngayHen: Date, gioHen: TimeSpan, maNV: String, thoiDiem: DateTime): LichHen
    + KiemTraThoiGianHopLe(thoiDiem: DateTime)
    + KiemTraHopLe()
    + KiemTraTrungLich()
    + Them()
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class NhanVienDB #BFDCF0 {
    + DocChiTiet(maNV: String): NhanVien
  }
  class LichHenDB #BFDCF0 {
    + KiemTraLichTrungCaNhanVien(maNV: String, ngayHen: Date, gioHen: TimeSpan): Boolean
    + Them(lichHen: LichHen)
  }
}

MHTaoLichHen o-- TaoLichHen
TaoLichHen o-- NhanVien
TaoLichHen o-- LichHen
NhanVien o-- NhanVienDB
LichHen o-- LichHenDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
TaoLichHen -[hidden]down- NhanVienDB
@enduml
