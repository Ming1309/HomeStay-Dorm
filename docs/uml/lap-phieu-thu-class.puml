@startuml

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5

skinparam class {
    HeaderBackgroundColor #AED6F1
    BorderColor #2980B9
    BackgroundColor #FFFFFF
    FontColor #000000
}

' =====================
' LỚP GIAO DIỆN
' =====================

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {

    class MHLapPhieuThu #BFE8BA {
        +lblThongTinPhieuThu : Label
        +grvDSHoaDonCanThu : DataGridView
        +lblTongCanThu : Label
        +lblSoTienThuTuMayChu : Label
        +lblCongNoCanThu : Label
        +lblThucThu : Label
        +lblConLaiSauThu : Label
        +radTienMat : RadioButton
        +radChuyenKhoan : RadioButton
        +btnTaiLenChungTu : Button
        +imgMinhChung : PictureBox
        +btnQuayLai : Button
        +btnXacNhanThuTien : Button
        ' ---
        +hienThiForm()
        +loadDSHoaDonCanThu()
        +btnXacNhanThuTien_Click()
        +btnQuayLai_Click()
    }
}

' =====================
' LỚP NGHIỆP VỤ
' =====================

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {

    class PhieuDoiSoat #F4E3A2 {
        +maPDS : String
        +ngayDoiSoat : DateTime
        +tyLeHoanCoc : Decimal
        +tongKhauTru : Decimal
        +tienThuThem : Decimal
        +trangThai : String
        +maHD : String
        +maNV : String
        +maPhieuCoc : String
        +maGiuong : String
        ' ---
        +layChiTietPhieuDoiSoat(maPDS : String) : PhieuDoiSoat
        +chuyenSangDaTatToan(maPDS : String) : Task
    }

    class HoaDon #F4E3A2 {
        +maHoaDon : String
        +hanThanhToan : DateTime
        +loaiHoaDon : String
        +tongTien : Decimal
        +trangThai : String
        +ghiChu : String
        +maHD : String
        +maNV : String
        ' ---
        +layDSHoaDonCanThuTheoPDS(maPDS : String) : List<HoaDon>
        +tinhTongCanThu(maPDS : String) : Decimal
    }

    class PhieuThu #F4E3A2 {
        +maPT : String
        +soTienThu : Decimal
        +thoiGian : DateTime
        +phuongThucThanhToan : String
        +anhMinhChung : String
        +maHoaDon : String
        +maPhieuCoc : String
        +maPDS : String
        +maNV : String
        ' ---
        +taoPhieuThu(maPDS : String, soTien : Decimal,\n  phuongThuc : String, anhMinhChung : String, maNV : String) : PhieuThu
        +daTonTaiChoPhieuDoiSoat(maPDS : String) : Boolean
    }

    class NhanVien #F4E3A2 {
        +maNV : String
        +hoTen : String
        +sdt : String
        +vaiTro : String
        +maCN : String
        ' ---
        +layThongTinNhanVien(maNV : String) : NhanVien
    }
}

' =====================
' LỚP TRUY XUẤT DỮ LIỆU
' =====================

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {

    class PhieuDoiSoatDB #BFDCF0 {
        +getPhieuDoiSoatTheoMaPDS(maPDS : String) : PhieuDoiSoat
        +updateTrangThai(maPDS : String, trangThaiHienTai : String, trangThaiMoi : String) : Integer
    }

    class HoaDonDB #BFDCF0 {
        +getDSHoaDonCanThuTheoPDS(maPDS : String) : List<HoaDon>
        +tinhTongCanThu(maPDS : String) : Decimal
    }

    class PhieuThuDB #BFDCF0 {
        +insertPhieuThu(phieuThu : PhieuThu) : String
        +tonTaiTheoMaPhieuDoiSoat(maPDS : String) : Boolean
    }

    class NhanVienDB #BFDCF0 {
        +getNhanVienTheoMaNV(maNV : String) : NhanVien
    }
}

' =====================
' QUAN HỆ
' =====================

MHLapPhieuThu o-- PhieuDoiSoat
MHLapPhieuThu o-- HoaDon
MHLapPhieuThu o-- PhieuThu
MHLapPhieuThu o-- NhanVien

PhieuDoiSoat o-- PhieuDoiSoatDB
HoaDon       o-- HoaDonDB
PhieuThu     o-- PhieuThuDB
NhanVien     o-- NhanVienDB


GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
PhieuDoiSoat -[hidden]down- PhieuDoiSoatDB
NhanVien -[hidden]down- PhieuDoiSoatDB
@enduml
