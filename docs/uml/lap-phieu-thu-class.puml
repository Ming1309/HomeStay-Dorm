@startuml LapPhieuThu_3Lop

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5

skinparam class {
    HeaderBackgroundColor #AED6F1
    BorderColor #2980B9
    BackgroundColor #FFFFFF
    FontColor #000000
}

' =====================
' LỚP GIAO DIỆN
' =====================

package "Lớp giao diện" #D6EAF8 {

    class MHLapPhieuThu {
        +lblThongTinPhieuThu : Label
        +grvDSHoaDonCanThu : DataGridView
        +lblTongCanThu : Label
        +txtSoTienThucThu : TextBox
        +lblCongNoCanThu : Label
        +lblThucThu : Label
        +lblConLaiSauThu : Label
        +radTienMat : RadioButton
        +radChuyenKhoan : RadioButton
        +btnTaiLenChungTu : Button
        +imgMinhChung : PictureBox
        +btnQuayLai : Button
        +btnXacNhanThuTien : Button
        ' ---
        +hienThiForm()
        +loadDSHoaDonCanThu()
        +tinhConLaiSauThu()
        +btnXacNhanThuTien_Click()
        +btnQuayLai_Click()
    }
}

' =====================
' LỚP NGHIỆP VỤ
' =====================

package "Lớp nghiệp vụ" #FEF9E7 {

    class PhieuDoiSoat {
        +maPDS : String
        +ngayDoiSoat : DateTime
        +tyLeHoanCoc : Decimal
        +tongKhauTru : Decimal
        +tienThuThem : Decimal
        +trangThai : String
        +maHD : String
        +maNV : String
        +maPhieuCoc : String
        +maGiuong : String
        ' ---
        +layChiTietPhieuDoiSoat(maPDS : String) : PhieuDoiSoat
        +capNhatTrangThai(maPDS : String, trangThai : String) : Boolean
    }

    class HoaDon {
        +maHoaDon : String
        +hanThanhToan : DateTime
        +loaiHoaDon : String
        +tongTien : Decimal
        +trangThai : String
        +ghiChu : String
        +maHD : String
        +maNV : String
        ' ---
        +layDSHoaDonCanThuTheoPDS(maPDS : String) : List<HoaDon>
        +tinhTongCanThu(maPDS : String) : Decimal
    }

    class PhieuThu {
        +maPT : String
        +soTienThu : Decimal
        +thoiGian : DateTime
        +phuongThucThanhToan : String
        +anhMinhChung : String
        +maHoaDon : String
        +maPhieuCoc : String
        +maPDS : String
        +maNV : String
        ' ---
        +taoPhieuThu(maPDS : String, soTien : Decimal,\n  phuongThuc : String, maNV : String) : PhieuThu
    }

    class NhanVien {
        +maNV : String
        +hoTen : String
        +sdt : String
        +vaiTro : String
        +maCN : String
        ' ---
        +layThongTinNhanVien(maNV : String) : NhanVien
    }
}

' =====================
' LỚP TRUY XUẤT DỮ LIỆU
' =====================

package "Lớp truy xuất dữ liệu" #F2F3F4 {

    class PhieuDoiSoatDB {
        +getPhieuDoiSoatTheoMaPDS(maPDS : String) : PhieuDoiSoat
        +updateTrangThai(maPDS : String, trangThai : String) : Boolean
    }

    class HoaDonDB {
        +getDSHoaDonCanThuTheoPDS(maPDS : String) : List<HoaDon>
        +tinhTongCanThu(maPDS : String) : Decimal
    }

    class PhieuThuDB {
        +insertPhieuThu(phieuThu : PhieuThu) : String
    }

    class NhanVienDB {
        +getNhanVienTheoMaNV(maNV : String) : NhanVien
    }
}

' =====================
' QUAN HỆ
' =====================

MHLapPhieuThu o-- PhieuDoiSoat
MHLapPhieuThu o-- HoaDon
MHLapPhieuThu o-- PhieuThu
MHLapPhieuThu o-- NhanVien

PhieuDoiSoat o-- PhieuDoiSoatDB
HoaDon       o-- HoaDonDB
PhieuThu     o-- PhieuThuDB
NhanVien     o-- NhanVienDB

@enduml
