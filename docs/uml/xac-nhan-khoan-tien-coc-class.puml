@startuml
title SO DO LOP 3 TANG - XAC NHAN KHOAN TIEN COC

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHXacNhanKhoanTienCoc {
    - txtTimKiemPhieu: TextBox
    - grvPhieuChoDoiChieu: GridView
    - lblMaPhieuCoc: Label
    - lblTrangThai: Label
    - lblHoTenKhachHang: Label
    - lblSoDienThoai: Label
    - lblPhong: Label
    - lblHinhThucThue: Label
    - lblSoGiuongThue: Label
    - lblTongTien: Label
    - lblPhuongThucThanhToan: Label
    - lblNhanVienSale: Label
    - grvGiuongSeKhoa: GridView
    - pnlChungTu: Panel
    - imgChungTu: Image
    - lnkMoChungTuPDF: Link
    - txtLyDoYeuCauBoSung: TextArea
    - btnXacNhan: Button
    - btnYeuCauBoSung: Button
    --
    + hienThiDanhSachPhieuChoDoiChieu(tuKhoa: String)
    + chonPhieuCoc(maPhieuCoc: String)
    + xacNhanHopLe()
    + yeuCauBoSung(lyDo: String)
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class XacNhanKhoanTienCoc {
    + LayDanhSachChoDoiChieu(text: String): IReadOnlyList<PhieuCoc>
    + LayChiTiet(maPhieuCoc: String): PhieuCoc
    + XacNhanHopLe(maPhieuCoc: String, maNhanVienQuanLy: String): KetQuaXacNhanKhoanTienCoc
    + YeuCauBoSung(maPhieuCoc: String, lyDo: String): PhieuCoc
  }

  class PhieuCoc {
    - MaPhieuCoc: String
    - TongTien: Decimal
    - AnhMinhChung: String
    - PhuongThucThanhToan: String
    - LyDoYeuCauBoSung: String
    - TrangThai: String
    - Giuongs: List<Giuong>
    --
    + LayDanhSachChoDoiChieu(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + KiemTraCoTheXacNhanThanhToan()
    + XacNhanThanhToan()
    + YeuCauBoSung(lyDo: String)
    + CapNhatXacNhanThanhToan()
    + CapNhatYeuCauBoSung()
  }

  class PhieuThu {
    - MaPT: String
    - SoTienThu: Decimal
    - ThoiGian: DateTime
    - MaPhieuCoc: String
    - MaNV: String
    --
    + TaoChoTienCoc(phieuCoc: PhieuCoc, maNhanVien: String, thoiGian: DateTime): PhieuThu
    + Them()
  }

  class Phong {
    - MaPhong: String
    - TrangThai: String
    - Giuongs: List<Giuong>
    --
    + DocChiTiet(maPhong: String): Phong
    + XacNhanDatCoc(maGiuongs: IEnumerable<String>)
    + CapNhatDatCoc()
  }

  class Giuong {
    - MaGiuong: String
    - MaPhong: String
    - TrangThai: String
    --
    + XacNhanDaCoc(maPhong: String)
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class PhieuCocDB {
    + LayDanhSachChoDoiChieu(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + CapNhatXacNhanThanhToan(phieu: PhieuCoc)
    + CapNhatYeuCauBoSung(phieu: PhieuCoc)
  }
  class PhieuThuDB {
    + Them(phieuThu: PhieuThu)
  }
  class PhongDB {
    + DocChiTiet(maPhong: String): Phong
    + CapNhatDatCoc(phong: Phong)
  }
}

MHXacNhanKhoanTienCoc o-- XacNhanKhoanTienCoc
XacNhanKhoanTienCoc o-- PhieuCoc
XacNhanKhoanTienCoc o-- PhieuThu
XacNhanKhoanTienCoc o-- Phong
PhieuCoc o-- PhieuCocDB
PhieuThu o-- PhieuThuDB
Phong o-- PhongDB
Phong "1" -- "1..*" Giuong : quan ly
PhieuCoc "1" -- "1..*" Giuong : dat coc

@enduml
