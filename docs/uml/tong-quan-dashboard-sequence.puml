@startuml
title SO DO TRINH TU - TONG QUAN DASHBOARD

skinparam shadowing false
skinparam responseMessageBelowArrow false

actor "Nhan vien" as Actor

box "GUI" #D5F5D3
  boundary "MHTongQuanDashboard" as MH
end box

box "BUS" #FCF3CF
  control "TongQuanDashboard" as UC
  control "NhanVien" as NV
  control "DashboardTongHop" as TH
end box

box "DB" #D6EAF8
  entity "DashboardDB" as DB
end box

Actor -> MH : Mo man hinh tong quan
activate MH
MH -> MH : HienThi()
MH -> MH : taiSnapshot()
MH -> UC : LaySale(maNV) / LayManager(maNV) / LayAccountant(maNV) / LayAdmin()
activate UC

alt Role Sale / QuanLy / KeToan
  UC -> NV : DocPhamVi(maNV)
  activate NV
  NV --> UC
  deactivate NV
  UC -> TH : LaySale|LayManager|LayAccountant(maCN, tenChiNhanh, asOf)
else Role QuanTri
  UC -> TH : LayAdmin(asOf)
end

activate TH
TH -> DB : LaySale|LayManager|LayAccountant|LayAdmin(...)
activate DB
DB --> TH : Snapshot
deactivate DB
TH --> UC : Snapshot
deactivate TH
UC --> MH : Snapshot
deactivate UC
MH -> MH : render KPI / task / hang cho / chart
deactivate MH

Actor -> MH : Nhan "Lam moi"
activate MH
MH -> MH : lamMoi()
MH -> UC : Lay...(...)
activate UC
UC --> MH : Snapshot
deactivate UC
deactivate MH

Actor -> MH : Nhan deep link viec can xu ly
activate MH
MH -> MH : moDeepLink(duongDan)
deactivate MH

@enduml
