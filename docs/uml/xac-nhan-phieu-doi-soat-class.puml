@startuml
title SO DO LOP 3 TANG - XAC NHAN PHIEU DOI SOAT
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}
package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHXacNhanPhieuDoiSoat #BFE8BA {
    + HienThi()
    + grvChoXacNhan_CellClick(maPDS: String)
    + btnXacNhan_Click()
  }
}
package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class XacNhanPhieuDoiSoat #F4E3A2 {
    + LayDanhSachChoXacNhan()
    + LayChiTiet(maPDS: String)
    + XacNhan(maPDS: String, khachHangDongY: Boolean, maNhanVien: String): PhieuDoiSoat
  }
  class PhieuDoiSoat #F4E3A2 {
    - TrangThai: String
    - TienHoan: Decimal
    - TienThuThem: Decimal
    + LayDanhSachChoXacNhan(): IReadOnlyList<PhieuDoiSoat>
    + LayChiTietPhieuDoiSoat(maPDS: String): PhieuDoiSoat
    + LayChiTietChoCapNhat(maPDS: String): PhieuDoiSoat
    + XacDinhKetQua(): ValueTuple
    + XacNhanKhachHangDongY(maNhanVien: String, thoiDiem: DateTime)
  }
  class PhieuCoc #F4E3A2 {
    - TongTien: Decimal
    - KhachHang: KhachHang
    - Phong: Phong
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
  }
  class KhachHang #F4E3A2 {
    - SDT: String
    - Email: String
    + CoKenhLienHe(): Boolean
  }
  class HoaDon #F4E3A2 {
    - TongTien: Decimal
    + LayDSHoaDonTheoPhieuDoiSoat(maPDS: String): IReadOnlyList<HoaDon>
  }
}
package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class PhieuDoiSoatDB #BFDCF0 {
    + GetDanhSachChoXacNhan(): IReadOnlyList<PhieuDoiSoat>
    + GetPhieuDoiSoatTheoMaPDS(maPDS: String): PhieuDoiSoat
    + GetPhieuDoiSoatChoCapNhat(maPDS: String): PhieuDoiSoat
    + XacNhan(phieu: PhieuDoiSoat, trangThaiMoi: String): Boolean
  }
  class PhieuCocDB #BFDCF0 {
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
  }
  class HoaDonDB #BFDCF0 {
    + GetDSHoaDonTheoMaPDS(maPDS: String): IReadOnlyList<HoaDon>
  }
}
MHXacNhanPhieuDoiSoat o-- XacNhanPhieuDoiSoat
XacNhanPhieuDoiSoat o-- PhieuDoiSoat
XacNhanPhieuDoiSoat o-- PhieuCoc
XacNhanPhieuDoiSoat o-- HoaDon
PhieuDoiSoat o-- PhieuDoiSoatDB
PhieuCoc o-- PhieuCocDB
PhieuCoc -- KhachHang
HoaDon o-- HoaDonDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
XacNhanPhieuDoiSoat -[hidden]down- PhieuDoiSoatDB
HoaDon -[hidden]down- PhieuDoiSoatDB
@enduml
