@startuml
title SO DO LOP 3 TANG - QUAN LY DICH VU (UC 1.4.26)
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHQuanLyDichVu #BFE8BA {
    - txtTimKiem: TextBox
    - cboTrangThai: ComboBox
    - tblDichVu: Table
    - dlgDichVu: Dialog
    + taiDanhSachDichVu()
    + luuDichVu(dichVu: DichVu)
    + xacNhanXoa()
  }
}
package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class QuanLyDichVu #F4E3A2 {
    + LayDanhSach(): List<DichVu>
    + Them(dichVu: DichVu): DichVu
    + CapNhat(maDV: String, thongTin: DichVu): DichVu
    + Xoa(maDV: String)
  }
  class DichVu #F4E3A2 {
    - MaDV: String
    - TenDV: String
    - DonViTinh: String
    - DonGia: Decimal
    - TrangThai: String
    + ChuanHoa()
    + KiemTraDuLieuHopLe()
    + LayDanhSach(): List<DichVu>
    + Doc(maDV: String): DichVu
    + DangDuocThamChieu(maDV: String): Boolean
    + Them()
    + CapNhat()
    + Xoa()
  }
}
package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class DichVuDB #BFDCF0 {
    + LayDanhSach(): List<DichVu>
    + Doc(maDV: String): DichVu
    + DangDuocThamChieu(maDV: String): Boolean
    + Them(dichVu: DichVu)
    + CapNhat(dichVu: DichVu)
    + Xoa(maDV: String)
  }
}
MHQuanLyDichVu o-- QuanLyDichVu
QuanLyDichVu o-- DichVu
DichVu o-- DichVuDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
QuanLyDichVu -[hidden]down- DichVuDB
@enduml
