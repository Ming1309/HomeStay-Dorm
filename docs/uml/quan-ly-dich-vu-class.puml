@startuml
title SO DO LOP 3 TANG - QUAN LY DICH VU (UC 1.4.26)
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHQuanLyDichVu {
    - txtTimKiem: TextBox
    - cboTrangThai: ComboBox
    - tblDichVu: Table
    - dlgDichVu: Dialog
    + loadServices()
    + onSubmit(values)
    + confirmDelete()
  }
}
package "TANG NGHIEP VU" #FCF3CF {
  class QuanLyDichVu {
    + LayDanhSach(): List<DichVu>
    + Them(dichVu: DichVu): DichVu
    + CapNhat(maDV: String, thongTin: DichVu): DichVu
    + Xoa(maDV: String)
  }
  class DichVu {
    - MaDV: String
    - TenDV: String
    - DonViTinh: String
    - DonGia: Decimal
    - TrangThai: String
    + ChuanHoa()
    + KiemTraDuLieuHopLe()
    + LayDanhSach(): List<DichVu>
    + Doc(maDV: String): DichVu
    + DangDuocThamChieu(maDV: String): Boolean
    + Them()
    + CapNhat()
    + Xoa()
  }
}
package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class DichVuDB {
    + LayDanhSach(): List<DichVu>
    + Doc(maDV: String): DichVu
    + DangDuocThamChieu(maDV: String): Boolean
    + Them(dichVu: DichVu)
    + CapNhat(dichVu: DichVu)
    + Xoa(maDV: String)
  }
}
MHQuanLyDichVu o-- QuanLyDichVu
QuanLyDichVu o-- DichVu
DichVu o-- DichVuDB
@enduml
