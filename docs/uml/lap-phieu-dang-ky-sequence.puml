@startuml
title SO DO TUAN TU - LAP PHIEU DANG KY
hide footbox
autonumber 1 1
skinparam shadowing false

actor "Nhan vien Sale" as Sale
box "GUI" #D5F5D3
boundary ": MHLapPhieuDangKy" as MH
end box
box "BUS" #FCF3CF
control ": LapPhieuDangKy" as UC
control ": NhanVien" as NV
control ": Phong" as P
control ": KhachHang" as KH
control ": PhieuDangKy" as PDK
end box
box "DB" #D6EAF8
entity ": NhanVienDB" as NVDB
entity ": PhongDB" as PDB
entity ": KhachHangDB" as KHDB
entity ": PhieuDangKyDB" as PDKDB
end box

Sale -> MH : Chon chuc nang "Lap phieu dang ky"
activate MH
MH -> MH : HienThi()
MH -> UC : LayKhuVucDangKy(maNV)
activate UC
UC -> NV : DocPhamVi(maNV)
activate NV
NV -> NVDB : DocChiTiet(maNV)
activate NVDB
deactivate NVDB
deactivate NV
UC -> P : LocPhongTheoTieuChi(null, null, null, maCN, null, 0, 0)
activate P
P -> PDB : LayPhongTheoBoLoc(null, null, null, maCN, null, 0, 0)
activate PDB
deactivate PDB
deactivate P
deactivate UC

Sale -> MH : Nhap thong tin dang ky
Sale -> MH : Nhan "Luu phieu"
MH -> MH : lapPhieuDangKy()
MH -> UC : TaoPhieuDangKy(hoTen, gioiTinh, sdt, email, loaiGiayTo, soGiayTo, khuVuc, soLuongNguoi, loaiDichVu, mucGia, thoiGianDuKienVao, thoiHanThue, yeuCauKhac, maNV)
activate UC
UC -> NV : DocPhamVi(maNV)
activate NV
NV -> NVDB : DocChiTiet(maNV)
activate NVDB
deactivate NVDB
deactivate NV
UC -> P : LocPhongTheoTieuChi(khuVuc, null, null, maCN, null, 0, 0)
activate P
P -> PDB : LayPhongTheoBoLoc(khuVuc, null, null, maCN, null, 0, 0)
activate PDB
deactivate PDB
deactivate P
UC -> KH : KiemTraTonTai(soGiayTo)
activate KH
KH -> KHDB : TimTheoSoGiayTo(soGiayTo)
activate KHDB
deactivate KHDB
deactivate KH
alt Khach hang chua ton tai
  UC -> KH : TaoMoi(hoTen, gioiTinh, sdt, email, null, loaiGiayTo, soGiayTo)
  activate KH
  deactivate KH
  UC -> KH : Them()
  activate KH
  KH -> KHDB : Them(khachHang)
  activate KHDB
  deactivate KHDB
  deactivate KH
end
UC -> PDK : TaoMoi(maKH, maNV, maCN, khuVuc, soLuongNguoi, loaiDichVu, mucGia, thoiGianDuKienVao, thoiHanThue, yeuCauKhac, thoiDiem)
activate PDK
PDK -> PDK : KiemTraDieuKien(thoiDiem)
deactivate PDK
UC -> PDK : Them()
activate PDK
PDK -> PDKDB : Them(phieuDangKy)
activate PDKDB
deactivate PDKDB
deactivate PDK
deactivate UC
deactivate MH
@enduml
