@startuml
title SO DO TUAN TU - LAP PHIEU COC

hide footbox
autonumber 1 1
skinparam shadowing false

actor "Nhan vien kinh doanh" as Sale
boundary ": MHLapPhieuCoc" as MH
control ": LapPhieuCoc" as LPC
control ": NhanVien" as NVI
entity ": NhanVienDB" as NVIDB
control ": LichHen" as LH
entity ": LichHenDB" as LHDB
control ": KhachHang" as KH
entity ": KhachHangDB" as KHDB
control ": Phong" as P
entity ": PhongDB" as PDB
control ": PhieuCoc" as PC
entity ": PhieuCocDB" as PCDB
control ": DichVuThongBao" as DVTB
control ": ThongBao" as TB
entity ": ThongBaoDB" as TBDB

Sale -> MH : HienThi()
activate MH
MH -> LPC : LayDanhSachKhachChoCoc(maNV)
activate LPC
LPC -> NVI : DocPhamVi(maNV)
activate NVI
NVI -> NVIDB : DocChiTiet(maNV)
activate NVIDB
deactivate NVIDB
deactivate NVI
LPC -> LH : LayDanhSachKhachChoCoc(maCN)
activate LH
LH -> LHDB : LayDanhSachKhachChoCoc(maCN)
activate LHDB
deactivate LHDB
deactivate LH
deactivate LPC

Sale -> MH : nhap tu khoa tim kiem
MH -> LPC : TimKiemKhachChoCoc(text, maNV)
activate LPC
LPC -> NVI : DocPhamVi(maNV)
activate NVI
NVI -> NVIDB : DocChiTiet(maNV)
activate NVIDB
deactivate NVIDB
deactivate NVI
LPC -> LH : LayDanhSachKhachChoCoc(maCN, text)
activate LH
LH -> LHDB : LayDanhSachKhachChoCoc(maCN, text)
activate LHDB
deactivate LHDB
deactivate LH
deactivate LPC

Sale -> MH : selectAppointment(lichHen)
MH -> LPC : LayChiTietLichHen(maLichHen, maNV)
activate LPC
LPC -> NVI : DocPhamVi(maNV)
activate NVI
NVI -> NVIDB : DocChiTiet(maNV)
activate NVIDB
deactivate NVIDB
deactivate NVI
LPC -> LH : DocChiTiet(maLichHen, maCN, false)
activate LH
LH -> LHDB : DocChiTiet(maLichHen, maCN, false)
activate LHDB
deactivate LHDB
deactivate LH
deactivate LPC

Sale -> MH : chinh sua thong tin khach hang

Sale -> MH : changeRentalType(hinhThucThue)

Sale -> MH : searchRooms()
alt HinhThucThue = NguyenCan
  MH -> LPC : LayPhongNguyenCan(toaNha, loaiPhong, giaMin, giaMax, gioiTinh, maNV)
  activate LPC
  LPC -> NVI : DocPhamVi(maNV)
  activate NVI
  NVI -> NVIDB : DocChiTiet(maNV)
  activate NVIDB
  deactivate NVIDB
  deactivate NVI
  LPC -> P : LayPhongNguyenCan(toaNha, loaiPhong, giaMin, giaMax, maCN, gioiTinh)
  activate P
  P -> PDB : LayPhongNguyenCan(toaNha, loaiPhong, giaMin, giaMax, maCN, gioiTinh)
  activate PDB
  deactivate PDB
  deactivate P
  deactivate LPC
else HinhThucThue = OGhep
  MH -> LPC : LayPhongOGhep(soLuong, toaNha, loaiPhong, giaMin, giaMax, gioiTinh, maNV)
  activate LPC
  LPC -> NVI : DocPhamVi(maNV)
  activate NVI
  NVI -> NVIDB : DocChiTiet(maNV)
  activate NVIDB
  deactivate NVIDB
  deactivate NVI
  LPC -> P : LayPhongOGhep(soLuong, toaNha, loaiPhong, giaMin, giaMax, maCN, gioiTinh)
  activate P
  P -> PDB : LayPhongOGhep(soLuong, toaNha, loaiPhong, giaMin, giaMax, maCN, gioiTinh)
  activate PDB
  deactivate PDB
  deactivate P
  deactivate LPC
end

opt HinhThucThue = NguyenCan
  Sale -> MH : selectWholeRoom(phong)
end
opt HinhThucThue = OGhep
  Sale -> MH : toggleBed(phong, maGiuong)
end

Sale -> MH : openConfirmation()
Sale -> MH : submitDeposit()
MH -> LPC : TaoPhieuCoc(maLichHen, thongTinKhachHang, maPhong, danhSachGiuong, hinhThucThue, maNV)
activate LPC

LPC -> NVI : DocPhamVi(maNV)
activate NVI
NVI -> NVIDB : DocChiTiet(maNV)
activate NVIDB
deactivate NVIDB
deactivate NVI

LPC -> LH : DocChiTiet(maLichHen, maCN, true)
activate LH
LH -> LHDB : DocChiTiet(maLichHen, maCN, true)
activate LHDB
deactivate LHDB
LH -> LH : KiemTraCoTheLapPhieuCoc()
deactivate LH

LPC -> KH : CapNhatTu(thongTinKhachHang)
activate KH
deactivate KH
opt Thong tin khach hang thay doi
  LPC -> KH : CapNhat()
  activate KH
  KH -> KHDB : CapNhat(khachHang)
  activate KHDB
  deactivate KHDB
  deactivate KH
end

LPC -> P : DocChiTiet(maPhong, maCN)
activate P
P -> PDB : DocChiTiet(maPhong, maCN)
activate PDB
deactivate PDB
P -> P : KiemTraGioiTinhChoPhep(dsKhach)
alt HinhThucThue = NguyenCan
  P -> P : GiuNguyenPhong()
else HinhThucThue = OGhep
  P -> P : GiuGiuong(danhSachGiuong)
end
deactivate P

LPC -> PC : TaoMoi(hinhThucThue, khachHang, phong, giuongs, maNV, thoiDiemCoc)
activate PC
deactivate PC
LPC -> PC : Them()
activate PC
PC -> PCDB : Them(phieuCoc)
activate PCDB
deactivate PCDB
deactivate PC

LPC -> LH : GanPhieuCoc(maPhieuCoc)
activate LH
deactivate LH
LPC -> P : CapNhat()
activate P
P -> PDB : CapNhat(phong)
activate PDB
deactivate PDB
deactivate P
LPC -> LH : LuuPhieuCoc()
activate LH
LH -> LHDB : GanPhieuCoc(lichHen)
activate LHDB
deactivate LHDB
deactivate LH

LPC -> DVTB : PhatCanXuLyTheoVaiTro(loaiSuKien, maCN, KeToan, tieuDe, noiDung, lienKet, maPhieuCoc, maNV)
activate DVTB
DVTB -> TB : Tao(loaiSuKien, CanXuLy, tieuDe, noiDung, maCN, KeToan, maNVNhan, lienKet, tone, khoaChongTrung, maNV, maPhieuCoc, thoiGianTao)
activate TB
deactivate TB
DVTB -> TB : Luu()
activate TB
TB -> TBDB : Them(thongBao, false)
activate TBDB
deactivate TBDB
deactivate TB
deactivate DVTB

deactivate LPC
deactivate MH
@enduml
