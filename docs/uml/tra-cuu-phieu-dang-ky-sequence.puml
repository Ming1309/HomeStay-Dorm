@startuml TraCuuPhieuDangKy_Sequence

skinparam sequenceArrowThickness 1.2
skinparam shadowing false
skinparam sequenceMessageAlign left

title Tra cứu phiếu đăng ký

actor "Nhân Viên Sale" as NVS

box "GUI" #D6EAF8
    boundary "MHTraCuuPhieuDangKy" as MH
end box

box "BUS" #FEF9E7
    control "PhieuDangKy" as PDK
    control "KhachHang" as KH
end box

box "DB" #F2F3F4
    entity "PhieuDangKyDB" as PDKDB
    entity "KhachHangDB" as KHDB
end box

' =====================
' LUỒNG CHÍNH
' =====================

NVS -> MH : 1.0 Truy cập chức năng\nTra cứu phiếu đăng ký
activate MH

NVS -> MH : 2.0 Nhập thông tin tìm kiếm\n(SĐT / CCCD / Email / Tên / Mã)

NVS -> MH : 3.0 btnTimKiem_Click()
activate MH #DAEEF8

MH -> PDK : 3.1 timKiemPhieuDangKy(tuKhoa)
activate PDK
PDK -> PDKDB : 3.2 timKiemPhieuDangKy(tuKhoa)
activate PDKDB
deactivate PDKDB
deactivate PDK

MH -> MH : 3.3 hienThiDSKetQua()

NVS -> MH : 4.0 Chọn "Xem chi tiết"\nmột PhieuDangKy
deactivate MH

activate MH #DAEEF8
MH -> PDK : 4.1 layChiTietPhieuDangKy(maPDK)
activate PDK
PDK -> PDKDB : 4.2 getPhieuDangKyTheoMaPDK(maPDK)
activate PDKDB
deactivate PDKDB
deactivate PDK

MH -> KH : 4.3 layThongTinKhachHang(maKH)
activate KH
KH -> KHDB : 4.4 getKhachHangTheoMaKH(maKH)
activate KHDB
deactivate KHDB
deactivate KH

MH -> MH : 4.5 hienThiChiTietPhieuDangKy()
deactivate MH
deactivate MH

' =====================
' LUỒNG PHỤ A3: Không nhập tiêu chí
' =====================

alt A3 - Không nhập thông tin tìm kiếm

    NVS -> MH : btnTimKiem_Click()\n(tuKhoa rỗng)
    activate MH
    MH -> MH : hienThiThongBao\n"Vui lòng nhập ít nhất\nmột tiêu chí tìm kiếm"
    deactivate MH

end

' =====================
' LUỒNG PHỤ A4: Không tìm thấy dữ liệu
' =====================

alt A4 - Không tìm thấy phiếu đăng ký khớp

    MH -> MH : hienThiThongBao\n"Không tìm thấy\nPhiếu đăng ký phù hợp"
    MH -> MH : lamTrongDSKetQua()

end

@enduml