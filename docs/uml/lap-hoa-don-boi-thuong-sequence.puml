@startuml LapHoaDonBoiThuong_Sequence

skinparam sequenceArrowThickness 1.2
skinparam shadowing false
skinparam sequenceMessageAlign left

title Lập hóa đơn bồi thường

actor "Kế Toán" as KT

box "GUI" #D5F5D3
    boundary "MHLapHoaDonBoiThuong" as MH
end box

box "BUS" #FCF3CF
    control "BienBanGiaoNhan" as BB
    control "ChiTietGiaoNhan" as CTGN
    control "TaiSan" as TS
    control "HoaDon" as HD
    control "ChiTietHoaDon" as CTHD
    control "NhanVien" as NV
end box

box "DB" #D6EAF8
    entity "BienBanGiaoNhanDB" as BBDB
    entity "ChiTietGiaoNhanDB" as CTGNDB
    entity "TaiSanDB" as TSDB
    entity "HoaDonDB" as HDDB
    entity "ChiTietHoaDonDB" as CTHDDB
    entity "NhanVienDB" as NVDB
end box

' =====================
' LUỒNG CHÍNH
' =====================

KT -> MH : 1.0 Truy cập chức năng\nLập hóa đơn bồi thường
activate MH

MH -> BB : 1.1 layDSBienBanThuHoiChuaXuLy()
activate BB
BB -> BBDB : 1.2 getDSBienBanThuHoiChuaXuLy()
activate BBDB
deactivate BBDB
deactivate BB


KT -> MH : 2.0 Chọn một Biên bản\ncần xử lý
MH -> BB : 2.1 layChiTietBienBan(maBienBan)
activate BB
BB -> BBDB : 2.2 getBienBanTheoMaBienBan(maBienBan)
activate BBDB
deactivate BBDB
deactivate BB

MH -> CTGN : 2.3 layDSTaiSanHuHongTheoBienBan(maBienBan)
activate CTGN
CTGN -> CTGNDB : 2.4 getDSTaiSanHuHongTheoBienBan(maBienBan)
activate CTGNDB
deactivate CTGNDB
deactivate CTGN

MH -> TS : 2.5 layThongTinTaiSan(maTS)
activate TS
TS -> TSDB : 2.6 getTaiSanTheoMaTS(maTS)
activate TSDB
deactivate TSDB
deactivate TS


KT -> MH : 3.0 Nhập số tiền phạt\nbồi thường cho từng tài sản

KT -> MH : Nhan "Lap Hoa Don Boi Thuong"
MH -> MH : 4.0 btnLapHoaDonBoiThuong_Click()
MH -> HD : 4.1 kiemTraTinhHopLe(dsSoTien)
activate HD
deactivate HD

MH -> NV : 4.2 layThongTinNhanVien(maNV)
activate NV
NV -> NVDB : 4.3 getNhanVienTheoMaNV(maNV)
activate NVDB
deactivate NVDB
deactivate NV

MH -> HD : 4.4 taoHoaDonBoiThuong(maBienBan, tongTien, maNV)
activate HD
HD -> HDDB : 4.5 insertHoaDon(hoaDon)
activate HDDB
deactivate HDDB
deactivate HD

MH -> CTHD : 4.6 taoChiTietHoaDon(maHoaDon, dsChiTiet)
activate CTHD
CTHD -> CTHDDB : 4.7 insertChiTietHoaDon(chiTiet)
activate CTHDDB
deactivate CTHDDB
deactivate CTHD

MH -> MH : 4.8 hienThiDialogThanhCong\n(maHoaDon, tongBoiThuong)


KT -> MH : Nhan "Hoan Tat"
MH -> MH : 5.0 btnHoanTat_Click()
deactivate MH

' =====================
' Số tiền không hợp lệ
' =====================

alt Số tiền không hợp lệ (trống / chữ cái / âm)

    MH -> MH : hienThiThongBaoLoi\n"Vui lòng nhập số tiền phạt hợp lệ"
    MH -> MH : boiDoTruongBiLoi()

end



@enduml