@startuml

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #AED6F1
skinparam classBorderColor #2980B9
skinparam classBackgroundColor #EBF5FB
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho

' =====================
' LỚP GIAO DIỆN
' =====================

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {

    class MHThanhToanTraPhong #BFE8BA {
    ' --- Danh sách phiếu ---
    +grvDSPhieuDoiSoat : DataGridView
    +txtTimKiem : TextBox
    ' --- Thông tin phiếu đối soát ---
    +lblMaPhieuDoiSoat : Label
    +lblHopDong : Label
    +lblKhachHang : Label
    +lblPhong : Label
    +lblNgayDoiSoat : Label
    +lblNguoiLap : Label
    +lblTrangThai : Label
    +lblKetQua : Label
    ' --- Bảng hóa đơn khấu trừ ---
    +grvDSHoaDon : DataGridView
    ' --- Kết quả đối soát ---
    +lblTienCocBanDau : Label
    +lblTyLeHoanCoc : Label
    +lblCocDuocXetHoan : Label
    +lblTongKhauTru : Label
    +lblDaBuTru : Label
    +lblConPhaiThu : Label
    +lblTongPhaiThuThem : Label
    +lblDaThu : Label
    +lblConPhaiThuThem : Label
    ' --- Nút hành động màn hình chính ---
    +btnTienHanhThuTien : Button

    ' --- Phương thức ---
    +hienThiForm()
    +loadDSPhieuDoiSoatCanThu()
    +hienThiChiTietPhieuDoiSoat()
    +hienThiDSHoaDonKhauTru()
    +hienThiKetQuaDoiSoat()
    +btnTienHanhThuTien_Click()
    +hienThiDialogLapPhieuThu()
    +btnXacNhanThuTien_Click()
    +btnQuayLai_Click()
}
}

' =====================
' LỚP NGHIỆP VỤ
' =====================

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {

    class PhieuDoiSoat #F4E3A2 {
        +maPDS : String
        +ngayDoiSoat : DateTime
        +tyLeHoanCoc : Decimal
        +tongKhauTru : Decimal
        +tienHoan : Decimal
        +tienThuThem : Decimal
        +trangThai : String
        +ghiChu : String
        +maHD : String
        +maNV : String
        +maPhieuCoc : String
        +maGiuong : String
        ' ---
        +layDSPhieuDoiSoatDaChot() : List<PhieuDoiSoat>
        +layChiTietPhieuDoiSoat(maPDS : String) : PhieuDoiSoat
        +tinhToanKetQua(maPDS : String) : Decimal
        +chuyenSangDaTatToan(maPDS : String) : Task
    }

    class HoaDon #F4E3A2 {
        +maHoaDon : String
        +ngayLap : DateTime
        +hanThanhToan : DateTime
        +loaiHoaDon : String
        +tongTien : Decimal
        +trangThai : String
        +ghiChu : String
        +maHD : String
        +maNV : String
        ' ---
        +layDSHoaDonTheoPhieuDoiSoat(maPDS : String) : List<HoaDon>
        +tinhTongKhauTru(maPDS : String) : Decimal
    }

    class PhieuThu #F4E3A2 {
        +maPT : String
        +soTienThu : Decimal
        +thoiGian : DateTime
        +phuongThucThanhToan : String
        +anhMinhChung : String
        +maHoaDon : String
        +maPhieuCoc : String
        +maPDS : String
        +maNV : String
        ' ---
        +taoPhieuThu(maPDS : String, soTien : Decimal, phuongThuc : String, anhMinhChung : String, maNV : String) : PhieuThu
        +daTonTaiChoPhieuDoiSoat(maPDS : String) : Boolean
    }

    class ChiTietDoiSoat #F4E3A2 {
        +maPDS : String
        +maHoaDon : String
        ' ---
        +layDSHoaDonThuocPhieuDoiSoat(maPDS : String) : List<HoaDon>
    }

    class NhanVien #F4E3A2 {
        +maNV : String
        +hoTen : String
        +sdt : String
        +vaiTro : String
        +maCN : String
        ' ---
        +layThongTinNhanVien(maNV : String) : NhanVien
    }
}

' =====================
' LỚP TRUY XUẤT DỮ LIỆU
' =====================

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {

    class PhieuDoiSoatDB #BFDCF0 {
        +getDSPhieuDoiSoatDaChot() : List<PhieuDoiSoat>
        +getPhieuDoiSoatTheoMaPDS(maPDS : String) : PhieuDoiSoat
        +updateTrangThai(maPDS : String, trangThaiHienTai : String, trangThaiMoi : String) : Integer
    }

    class HoaDonDB #BFDCF0 {
        +getDSHoaDonTheoMaPDS(maPDS : String) : List<HoaDon>
        +tinhTongKhauTru(maPDS : String) : Decimal
    }

    class PhieuThuDB #BFDCF0 {
        +insertPhieuThu(phieuThu : PhieuThu) : String
        +tonTaiTheoMaPhieuDoiSoat(maPDS : String) : Boolean
    }

    class ChiTietDoiSoatDB #BFDCF0 {
        +getDSHoaDonThuocPhieuDoiSoat(maPDS : String) : List<HoaDon>
    }

    class NhanVienDB #BFDCF0 {
        +getNhanVienTheoMaNV(maNV : String) : NhanVien
    }
}

' =====================
' QUAN HỆ
' =====================

MHThanhToanTraPhong o-- PhieuDoiSoat
MHThanhToanTraPhong o-- HoaDon
MHThanhToanTraPhong o-- PhieuThu
MHThanhToanTraPhong o-- ChiTietDoiSoat
MHThanhToanTraPhong o-- NhanVien

PhieuDoiSoat   o-- PhieuDoiSoatDB
HoaDon         o-- HoaDonDB
PhieuThu       o-- PhieuThuDB
ChiTietDoiSoat o-- ChiTietDoiSoatDB
NhanVien       o-- NhanVienDB


GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
PhieuDoiSoat -[hidden]down- PhieuDoiSoatDB
NhanVien -[hidden]down- PhieuDoiSoatDB
@enduml
