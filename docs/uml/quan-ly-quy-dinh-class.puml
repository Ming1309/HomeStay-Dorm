@startuml
title SO DO LOP 3 TANG - QUAN LY QUY DINH LUU TRU

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHQuanLyQuyDinh #BFE8BA {
    - txtTimKiem: TextBox
    - lstLoaiQuyDinh: ListBox
    - lstTrangThai: ListBox
    - grvDanhSachQuyDinh: GridView
    - txtTenQuyDinh: TextBox
    - dtNgayApDung: DatePicker
    - dtNgayKetThuc: DatePicker
    - fileVanBan: FileInput
    - btnThem: Button
    - btnSua: Button
    - btnXoa: Button
    --
    + HienThi()
    + btnThem_Click()
    + btnSua_Click()
    + btnXoa_Click()
    + btnXemVanBan_Click()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class QuanLyQuyDinh #F4E3A2 {
    + LayDanhSach(): IReadOnlyList<QuyDinh>
    + Them(quyDinh: QuyDinh, tep: TepQuyDinh): QuyDinh
    + CapNhat(maQD: String, thongTin: QuyDinh, tepMoi: TepQuyDinh): QuyDinh
    + Xoa(maQD: String)
    + DocVanBan(tenTep: String): NoiDungQuyDinh
  }

  class QuyDinh #F4E3A2 {
    - MaQD: String
    - TenQD: String
    - LoaiQD: String
    - DuongDanFile: String
    - NgayApDung: DateOnly
    - NgayKetThuc: DateOnly
    --
    + ChuanHoa()
    + KiemTraDuLieuHopLe(yeuCauDuongDan: Boolean)
    + LayDanhSach(): IReadOnlyList<QuyDinh>
    + Doc(maQD: String): QuyDinh
    + DangDuocThamChieu(maQD: String): Boolean
    + Them()
    + CapNhat()
    + Xoa()
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class QuyDinhDB #BFDCF0 {
    + LayDanhSach(): IReadOnlyList<QuyDinh>
    + Doc(maQD: String): QuyDinh
    + DangDuocThamChieu(maQD: String): Boolean
    + Them(quyDinh: QuyDinh)
    + CapNhat(quyDinh: QuyDinh)
    + Xoa(maQD: String)
  }

  class QuyDinhFileStorage #BFDCF0 {
    + Luu(tep: TepQuyDinh): String
    + Doc(tenTep: String): NoiDungQuyDinh
    + Xoa(duongDan: String)
  }
}

MHQuanLyQuyDinh o-- QuanLyQuyDinh
QuanLyQuyDinh o-- QuyDinh : quan ly
QuanLyQuyDinh o-- QuyDinhFileStorage : quan ly PDF
QuyDinh o-- QuyDinhDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
QuanLyQuyDinh -[hidden]down- QuyDinhDB
@enduml
