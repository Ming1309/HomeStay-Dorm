        -lblGioNhanPhongCard: Label
        -badgeTrangThaiThanhToanCard: Label
        --
        -lblMaPhieuCocDangChon: Label
        -lblTenKhachDangChon: Label
        -badgeDaThanhToan: Label
        -badgeSoGiuong: Label
        -badgeHinhThucThue: Label
        -lblPhongDangChon: Label
        -lblGioNhanPhongDangChon: Label
        --
