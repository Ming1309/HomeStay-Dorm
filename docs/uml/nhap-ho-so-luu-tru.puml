@startuml UC11_3Layers_NhapHoSoLuuTru
title 3 Layers - UC Nhập hồ sơ lưu trú

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
hide circle

