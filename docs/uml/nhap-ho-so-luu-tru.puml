@startuml UC11_3Layers_NhapHoSoLuuTru
title SO DO LOP 3 TANG - NHAP HO SO LUU TRU

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHNhapHoSoLuuTru {
    - lblTieuDePhieuCoc: Label
    - lblSoLuongPhieuHomNay: Label
    - txtTimKiemPhieuCoc: TextBox
    - pnlDanhSachPhieuCoc: Panel
    - cardPhieuCoc: Panel
    - lblMaPhieuCocCard: Label
    - lblTenKhachCard: Label
    - lblSDTCard: Label
    - lblPhongCard: Label
    - badgeTrangThaiThanhToanCard: Badge
    - lblMaPhieuCocDangChon: Label
    - lblTenKhachDangChon: Label
    - badgeDaThanhToan: Badge
    - badgeSoGiuong: Badge
    - badgeHinhThucThue: Badge
    - lblPhongDangChon: Label
    - lblHoTen: Label
    - txtHoTen: TextBox
    - lblSoDienThoai: Label
    - txtSoDienThoai: TextBox
    - lblEmail: Label
    - txtEmail: TextBox
    - lblGioiTinh: Label
    - cboGioiTinh: ComboBox
    - lblNgaySinh: Label
    - txtNgaySinh: TextBox
    - lblQuocTich: Label
    - txtQuocTich: TextBox
    - lblLoaiGiayTo: Label
    - cboLoaiGiayTo: ComboBox
    - lblSoGiayTo: Label
    - txtSoGiayTo: TextBox
    - lblDiaChiThuongTru: Label
    - txtDiaChiThuongTru: TextBox
    - txtSoNhaTenDuong: TextBox
    - cboTinhTP: ComboBox
    - cboQuanHuyen: ComboBox
    - cboPhuongXa: ComboBox
    - txtDiaChiNuocNgoai: TextBox
    - grpNguoiOCung: GroupBox
    - btnThemNguoiOCung: Button
    - btnLuuHoSo: Button
    --
    + loadDanhSachPhieuCoc()
    + timKiemPhieuCoc()
    + clickChonPhieuCoc()
    + hienThiThongTinTuPhieuCoc()
    + nhapThongTinCuTru()
    + clickThemNguoiOCung()
    + clickLuuHoSo()
    + hienThiThongBao()
    + hienThiLoi()
  }

  class PopupThemNguoiOCung {
    - lblTieuDePopup: Label
    - btnDongPopup: Button
    - txtHoTen: TextBox
    - txtSoDienThoai: TextBox
    - cboGioiTinh: ComboBox
    - txtNgaySinh: TextBox
    - txtQuocTich: TextBox
    - cboLoaiGiayTo: ComboBox
    - txtSoGiayTo: TextBox
    - txtSoNhaTenDuong: TextBox
    - cboTinhTP: ComboBox
    - cboQuanHuyen: ComboBox
    - cboPhuongXa: ComboBox
    - txtDiaChiNuocNgoai: TextBox
    - btnHuy: Button
    - btnXacNhan: Button
    --
    + hienThiPopup()
    + nhapThongTinNguoiOCung()
    + clickXacNhan()
    + clickHuy()
    + clickDongPopup()
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class NhapHoSoLuuTru {
    + LayDanhSachChoNhap(text: String): IReadOnlyList<PhieuCoc>
    + LayChiTiet(maPhieuCoc: String): PhieuCoc
    + NhapHoSo(maPhieuCoc: String, nguoiDaiDien: KhachHang, hinhThucThue: String, cacThanhVien: List<KhachHang>): PhieuCoc
  }

  class PhieuCoc {
    - MaPhieuCoc: String
    - HanThanhToan: DateTime
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - ThoiDiemCoc: DateTime
    - AnhMinhChung: String
    - PhuongThucThanhToan: String
    - LyDoYeuCauBoSung: String
    - TrangThai: String
    - MaKH: String
    - MaPhong: String
    - MaNV: String
    - KhachHang: KhachHang
    - Phong: Phong
    - Giuongs: List<Giuong>
    - ThanhViens: List<ThanhVienDangKy>
    --
    + LayPhieuCocDaThanhToanNhanPhongHomNay(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + KiemTraDaThanhToan()
    + KiemTraHinhThucThue()
    + KiemTraSoLuongThanhVien(soLuongThanhVien: Integer)
    + CapNhatTrangThai(trangThai: String)
    + LuuCapNhatTrangThai()
  }

  class LichHen {
    - MaLH: String
    - NgayHen: DateTime
    - GioHen: TimeSpan
    - LoaiLichHen: String
    - TrangThai: String
    - MaPDK: String
    - MaPhieuCoc: String
    - MaHD: String
    - MaNV: String
    - MaCN: String
    - KhachHang: KhachHang
    --
    + DocTheoMaPhieuCoc(maPhieuCoc: String): LichHen
    + KiemTraLichNhanPhongHomNay(): Boolean
    + KiemTraLoaiNhanPhong()
    + KiemTraTrangThaiHopLe()
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - NgaySinh: DateTime
    - GioiTinh: String
    - QuocTich: String
    - LoaiGiayTo: String
    - SoGiayTo: String
    - DiaChiThuongTru: String
    - SDT: String
    - Email: String
    --
    + TimTheoSoGiayTo(soGiayTo: String): KhachHang
    + TaoMaMoi(thoiDiem: DateTime): String
    + KiemTraThongTinBatBuoc(kh: KhachHang)
    + KiemTraDinhDangEmail(email: String): Boolean
    + KiemTraSoGiayTo(soGiayTo: String, loaiGiayTo: String): Boolean
    + KiemTraNgaySinh(ngaySinh: DateTime): Boolean
    + KiemTraTrungSoGiayTo(nguoiDaiDien: KhachHang, cacThanhVien: List<KhachHang>)
    + CapNhatTu(thongTinMoi: KhachHang): Boolean
    + ThemMoi()
    + CapNhat()
  }

  class ThanhVienDangKy {
    - MaPhieuCoc: String
    - MaKH: String
    - VaiTro: String
    - TrangThaiDuyet: String
    --
    + TaoDaiDien(maPhieuCoc: String, maKH: String): ThanhVienDangKy
    + TaoThanhVien(maPhieuCoc: String, maKH: String): ThanhVienDangKy
    + KiemTraTonTaiDaiDien(maPhieuCoc: String)
    + KiemTraVaiTroHopLe()
    + XoaTheoPhieuCoc(maPhieuCoc: String)
    + ThemHangLoat(danhSach: List<ThanhVienDangKy>)
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - Tang: String
    - GioiTinhChoPhep: String
    - TrangThai: String
    - MaLP: String
    - MaCN: String
    - LoaiPhong: LoaiPhong
    - Giuongs: List<Giuong>
    --
    + KiemTraSucChua(soLuongNguoi: Integer)
  }

  class LoaiPhong {
    - MaLP: String
    - TenLoaiPhong: String
    - SucChua: Integer
    - GiaThue: Decimal
  }

  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
    - MaPhong: String
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class LichHenDB {
    + DocTheoMaPhieuCoc(maPhieuCoc: String): LichHen
  }

  class PhieuCocDB {
    + LayPhieuCocDaThanhToanNhanPhongHomNay(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + CapNhatTrangThai(maPhieuCoc: String, trangThai: String)
  }

  class KhachHangDB {
    + TimTheoSoGiayTo(soGiayTo: String): KhachHang
    + Them(khachHang: KhachHang)
    + CapNhat(khachHang: KhachHang)
  }

  class ThanhVienDangKyDB {
    + LayTheoMaPhieuCoc(maPhieuCoc: String): List<ThanhVienDangKy>
    + XoaTheoPhieuCoc(maPhieuCoc: String)
    + ThemHangLoat(danhSach: List<ThanhVienDangKy>)
  }
}

' Boundary dieu khien use case nhap ho so.
MHNhapHoSoLuuTru  o--  NhapHoSoLuuTru
PopupThemNguoiOCung  o--  KhachHang

' Use case dieu phoi cac entity.
NhapHoSoLuuTru  o--  LichHen
NhapHoSoLuuTru  o--  PhieuCoc
NhapHoSoLuuTru  o--  KhachHang
NhapHoSoLuuTru  o--  ThanhVienDangKy

' Trong BLL: duong thang, khong huong.
PhieuCoc "1" -- "1..*" ThanhVienDangKy : gom
PhieuCoc "0..*" -- "1" KhachHang : dai dien
PhieuCoc "0..*" -- "1" Phong : dat
LichHen "1" -- "0..1" PhieuCoc : nhan
ThanhVienDangKy "0..*" -- "1" KhachHang : thong tin
Phong "0..*" -- "1" LoaiPhong : thuoc
Phong "1" -- "1..*" Giuong : chua

' Aggregation giua business va data access.
LichHen  o--  LichHenDB
PhieuCoc  o--  PhieuCocDB
KhachHang  o--  KhachHangDB
ThanhVienDangKy  o--  ThanhVienDangKyDB

@enduml
