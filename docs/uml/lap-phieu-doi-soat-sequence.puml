@startuml LapPhieuDoiSoat_Sequence

skinparam sequenceArrowThickness 1.2
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 80

title Lập phiếu đối soát

actor "Kế toán" as KT

box "GUI" #F9FBE7
boundary "MHLapPhieuDoiSoat" as MH
end box

box "BUS" #FEF9E7
control "DieuKhienLapPhieuDoiSoat" as DK
control "HopDong" as HD
control "PhieuCoc" as PC
control "ChinhSachHoanCoc" as CS
control "HoaDon" as HOADON
control "PhieuDoiSoat" as PDS
control "DichVuThongBao" as TB
end box

box "DB" #F5EEF8
entity "NhanVienDB" as NVDB
entity "HopDongDB" as HDDB
entity "PhieuCocDB" as PCDB
entity "ChinhSachHoanCocDB" as CSDB
entity "HoaDonDB" as HDONDB
entity "PhieuDoiSoatDB" as PDSDB
end box


'=====================
' TẢI DANH SÁCH HỒ SƠ CHỜ ĐỐI SOÁT
'=====================

KT -> MH : 1.0 Truy cập chức năng
activate MH

MH -> DK : 1.1 khoiTaoForm(maNVDangNhap)
activate DK

DK -> NVDB : 1.2 getNhanVien(maNVDangNhap)
activate NVDB
deactivate NVDB

DK -> HD : 1.3 layDanhSachChoDoiSoat()
activate HD

HD -> HDDB : 1.4 getDanhSachChoDoiSoat()
activate HDDB
deactivate HDDB

deactivate HD

DK -> PC : 1.5 layDanhSachDaHuyDaThanhToan()
activate PC

PC -> PCDB : 1.6 getDanhSachDaHuyDaThanhToan()
activate PCDB
deactivate PCDB

deactivate PC

DK -> MH : 1.7 hienThiDanhSachHoSo()

deactivate DK
deactivate MH


'=====================
' CHỌN HỒ SƠ VÀ TÍNH TOÁN
'=====================

KT -> MH : 2.0 Chọn hồ sơ
activate MH

MH -> DK : 2.1 layChiTietVaTinhToan(maHoSo, loaiHoSo)
activate DK

DK -> CS : 2.2 layChinhSachDangApDung()
activate CS

CS -> CSDB : 2.3 getChinhSachDangApDung()
activate CSDB
deactivate CSDB

deactivate CS

alt A2 Hồ sơ là Phiếu cọc đã hủy

DK -> PC : A2.1 laySoTienCoc(maPhieuCoc)
activate PC

PC -> PCDB : A2.2 getSoTienCoc(maPhieuCoc)
activate PCDB
deactivate PCDB

deactivate PC

DK -> PDS : A2.3 apDungChinhSachHoanCoc(tiLeChuaKy)
activate PDS

PDS -> PDS : A2.4 tinhTongKhauTru(0)

deactivate PDS

else Hồ sơ là Hợp đồng chờ thanh lý

DK -> HD : 2.4 layThongTinLuuTru(maHD)
activate HD

HD -> HDDB : 2.5 getThongTinLuuTru(maHD)
activate HDDB
deactivate HDDB

deactivate HD

DK -> CS : 2.6 xacDinhTyLeHoan(thoiGianLuuTru)
activate CS
deactivate CS

DK -> HOADON : 2.7 layDanhSachChuaThanhToan(maHD)
activate HOADON

HOADON -> HDONDB : 2.8 getDanhSachChuaThanhToanTheoHD(maHD)
activate HDONDB
deactivate HDONDB

deactivate HOADON

DK -> PDS : 2.9 tinhToanDoiSoat(tienCoc, tyLe, dsHoaDon)
activate PDS

PDS -> PDS : 2.10 chotKetQua()

deactivate PDS

end

DK -> MH : 2.11 hienThiChiTietTinhToan()

deactivate DK
deactivate MH


'=====================
' TẠO PHIẾU ĐỐI SOÁT
'=====================

KT -> MH : 3.0 btnTaoPhieuDoiSoat_Click()
activate MH

MH -> DK : 3.1 taoPhieuDoiSoat(maHoSo, ketQuaTinhToan)
activate DK

DK -> PDS : 3.2 luuPhieu()
activate PDS

PDS -> PDSDB : 3.3 insertPhieuDoiSoat()
activate PDSDB
deactivate PDSDB

PDS -> PDSDB : 3.4 insertChiTietDoiSoat()
activate PDSDB
deactivate PDSDB

deactivate PDS

DK -> TB : 3.5 guiThongBaoQuanLy(maPDS)
activate TB
deactivate TB

DK -> MH : 3.6 hienThiThongBaoThanhCong()

deactivate DK
deactivate MH

@enduml
