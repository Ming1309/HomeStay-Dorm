@startuml
title SO DO TUAN TU - XU LY THANH TOAN HOP DONG
hide footbox
autonumber 1 1
skinparam shadowing false
actor "Ke toan" as KT
box "GUI" #D5F5D3
boundary ": MHXuLyThanhToanHopDong" as MH
end box
box "BUS" #FCF3CF
control ": XuLyThanhToanHopDong" as UC
control ": HopDong" as HD
control ": DichVuHopDong" as DVHD
control ": HoaDon" as HDon
control ": ChiTietHoaDon" as CT
control ": PhieuThu" as PT
end box
box "DB" #D6EAF8
entity ": HopDongDB" as HDDB
entity ": DichVuHopDongDB" as DVHDDB
entity ": HoaDonDB" as HDonDB
entity ": ChiTietHoaDonDB" as CTDB
entity ": PhieuThuDB" as PTDB
end box

KT -> MH : Chon chuc nang "Thanh toan hop dong"
activate MH
MH -> MH : taiHangDoiThuTien()
MH -> UC : LayDSChoThanhToan()
activate UC
UC -> HD : LayDanhSachChoThanhToan()
activate HD
HD -> HDDB : LayDanhSachChoThanhToan()
activate HDDB
deactivate HDDB
deactivate HD
deactivate UC

KT -> MH : Chon hop dong cho thanh toan
MH -> MH : clickChonHopDong()
MH -> UC : LayChiTietThanhToan(maHD)
activate UC
UC -> HD : DocChiTiet(maHD)
activate HD
HD -> HDDB : DocChiTiet(maHD)
activate HDDB
deactivate HDDB
HD -> HD : KiemTraChoThanhToan()
deactivate HD
opt Hop dong chua nap san danh sach dich vu
  UC -> DVHD : LayDanhSachTheoHopDong(maHD)
  activate DVHD
  DVHD -> DVHDDB : LayDanhSachTheoHopDong(maHD)
  activate DVHDDB
  deactivate DVHDDB
  deactivate DVHD
end
deactivate UC

KT -> MH : Nhan "Tien hanh thu tien"
MH -> MH : clickTienHanhThuTien()
KT -> MH : Chon phuong thuc va cung cap minh chung
KT -> MH : Xac nhan thu tien
MH -> UC : TienHanhThuTien(maHD, phuongThuc, anhMinhChung, maNV)
activate UC
UC -> HD : DocChiTiet(maHD)
activate HD
HD -> HDDB : DocChiTiet(maHD)
activate HDDB
deactivate HDDB
HD -> HD : KiemTraChoThanhToan()
deactivate HD
UC -> HDon : KiemTraChuaCoHoaDonKyDau(maHD)
activate HDon
HDon -> HDonDB : ExistsHoaDonKyDau(maHD)
activate HDonDB
deactivate HDonDB
deactivate HDon
opt Hop dong chua nap san danh sach dich vu
  UC -> DVHD : LayDanhSachTheoHopDong(maHD)
  activate DVHD
  DVHD -> DVHDDB : LayDanhSachTheoHopDong(maHD)
  activate DVHDDB
  deactivate DVHDDB
  deactivate DVHD
end
UC -> CT : TaoDongTienThueKyDau("TEMP", 1, giaThue, kyThanhToan)
activate CT
deactivate CT
UC -> CT : TaoDongDichVu("TEMP", dichVus, 2)
activate CT
deactivate CT
UC -> HDon : TaoHoaDonKyDauDaThanhToan(maHD, tongCong, maNV, thoiDiem, chiTiet)
activate HDon
HDon -> HDonDB : Insert(hoaDon)
activate HDonDB
deactivate HDonDB
deactivate HDon
UC -> CT : LuuDanhSachChiTietHoaDon(chiTiet)
activate CT
CT -> CTDB : InsertBatch(chiTiet)
activate CTDB
deactivate CTDB
deactivate CT
UC -> PT : TaoPhieuThuTienHoaDon(maHoaDon, tongCong, phuongThuc, anhMinhChung, maNV, thoiDiem)
activate PT
PT -> PTDB : InsertPhieuThu(phieuThu)
activate PTDB
deactivate PTDB
deactivate PT
UC -> HD : CapNhatTrangThaiChoBanGiao(maHD)
activate HD
HD -> HDDB : UpdateTrangThai(maHD, "ChoBanGiao")
activate HDDB
deactivate HDDB
deactivate HD
deactivate UC
deactivate MH
@enduml
