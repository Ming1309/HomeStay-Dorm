@startuml
title SO DO LOP 3 TANG - HUY PHIEU COC
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}
package "TANG GIAO DIEN" #EAF2F8 {
  class MHHuyPhieuCoc {
    + select(id: String)
    + confirm()
  }
}
package "TANG NGHIEP VU" #FCF3CF {
  class HuyPhieuCoc {
    + Huy(maPhieuCoc: String, maNhanVien: String): PhieuCoc
  }
  class HopDong {
    + TonTaiTheoPhieuCoc(maPhieuCoc: String): Boolean
  }
  class PhieuCoc {
    - TrangThai: String
    - DaDongTien: Boolean
    - ThoiDiemHuy: DateTime
    - MaNVHuy: String
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + Huy(maNhanVien: String, thoiDiem: DateTime)
    + CapNhatHuy()
  }
  class Phong {
    + DocChiTiet(maPhong: String): Phong
    + GiaiPhongDatCoc(maGiuongs: IEnumerable<String>)
    + CapNhatGiaiPhongDatCoc()
  }
  class DichVuThongBao {
    + GuiThongBaoKeToan(tieuDe: String, noiDung: String, lienKet: String, maNVGui: String, maThamChieu: String)
  }
  class ThongBao {
    + Tao(tieuDe: String, noiDung: String, vaiTroNhan: String, lienKet: String, tone: String, maNVGui: String, maThamChieu: String, thoiGianTao: DateTime): ThongBao
    + Luu()
  }
}
package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class HopDongDB { + TonTaiTheoPhieuCoc(maPhieuCoc: String): Boolean }
  class PhieuCocDB {
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + CapNhatHuy(phieu: PhieuCoc)
  }
  class PhongDB {
    + DocChiTiet(maPhong: String): Phong
    + CapNhatGiaiPhongDatCoc(phong: Phong)
  }
  class ThongBaoDB { + Them(thongBao: ThongBao) }
}
MHHuyPhieuCoc o-- HuyPhieuCoc
HuyPhieuCoc o-- HopDong
HuyPhieuCoc o-- PhieuCoc
HuyPhieuCoc o-- Phong
HuyPhieuCoc o-- DichVuThongBao
DichVuThongBao o-- ThongBao
HopDong o-- HopDongDB
PhieuCoc o-- PhieuCocDB
Phong o-- PhongDB
ThongBao o-- ThongBaoDB
@enduml
