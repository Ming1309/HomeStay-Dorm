@startuml
title SO DO LOP 3 TANG - HUY PHIEU COC
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHHuyPhieuCoc #BFE8BA {
    - txtTimKiemPhieu: TextBox
    - grvPhieuCocCoTheHuy: GridView
    - lblSoPhieuCoTheHuy: Label
    - lblMaPhieuCoc: Label
    - lblTrangThai: Label
    - lblHoTenKhachHang: Label
    - lblSoDienThoai: Label
    - lblEmail: Label
    - lblSoGiayTo: Label
    - lblPhong: Label
    - lblHinhThucThue: Label
    - lblThoiDiemCoc: Label
    - lblTongTien: Label
    - lblTrangThaiThanhToan: Label
    - grvGiuongLienQuan: GridView
    - dlgXacNhanHuy: AlertDialog
    - btnHuyPhieuCoc: Button
    --
    + HienThi()
    + taiDanhSachCoTheHuy(text: String)
    + chonPhieuCoc(maPhieuCoc: String)
    + moHopThoaiXacNhan()
    + huyPhieuCoc()
  }
}
package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class TraCuuPhieuCoc #F4E3A2 {
    + LayDanhSachCoTheHuy(text: String, maNV: String): IReadOnlyList<PhieuCoc>
    + LayChiTiet(maPhieuCoc: String, maNV: String): PhieuCoc
  }
  class HuyPhieuCoc #F4E3A2 {
    + Huy(maPhieuCoc: String, maNhanVien: String): PhieuCoc
  }
  class NhanVien #F4E3A2 {
    - MaNV: String
    - MaCN: String
    + DocPhamVi(maNV: String): NhanVien
  }
  class HopDong #F4E3A2 {
    + TonTaiTheoPhieuCoc(maPhieuCoc: String): Boolean
  }
  class PhieuCoc #F4E3A2 {
    - MaPhieuCoc: String
    - MaCN: String
    - MaKH: String
    - MaPhong: String
    - MaNV: String
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - ThoiDiemCoc: DateTime
    - TrangThai: String
    - ThoiDiemHuy: DateTime
    - MaNVHuy: String
    - DaDongTien: Boolean
    - KhachHang: KhachHang
    - Phong: Phong
    - Giuongs: List<Giuong>
    --
    + LayDanhSachCoTheHuy(maCN: String, text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String, maCN: String): PhieuCoc
    + DocChiTietChoCapNhat(maPhieuCoc: String, maCN: String): PhieuCoc
    + Huy(maNhanVien: String, thoiDiem: DateTime)
    + CapNhatHuy()
  }
  class Phong #F4E3A2 {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - Giuongs: List<Giuong>
    --
    + DocChiTiet(maPhong: String): Phong
    + GiaiPhongDatCoc(maGiuongs: IEnumerable<String>)
    + CapNhatGiaiPhongDatCoc()
  }
  class KhachHang #F4E3A2 {
    - MaKH: String
    - HoTen: String
    - SDT: String
    - Email: String
    - LoaiGiayTo: String
    - SoGiayTo: String
  }
  class Giuong #F4E3A2 {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
    - MaPhong: String
    --
    + GiaiPhong(maPhong: String)
  }
}
package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class NhanVienDB #BFDCF0 {
    + DocChiTiet(maNV: String): NhanVien
  }
  class HopDongDB #BFDCF0 {
    + TonTaiTheoPhieuCoc(maPhieuCoc: String): Boolean
  }
  class PhieuCocDB #BFDCF0 {
    + LayDanhSachCoTheHuy(maCN: String, text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String, maCN: String): PhieuCoc
    + DocChiTietChoCapNhat(maPhieuCoc: String, maCN: String): PhieuCoc
    + CapNhatHuy(phieu: PhieuCoc)
  }
  class PhongDB #BFDCF0 {
    + DocChiTiet(maPhong: String): Phong
    + CapNhatGiaiPhongDatCoc(phong: Phong)
  }
}
GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
MHHuyPhieuCoc o-down- HuyPhieuCoc
MHHuyPhieuCoc o-down- TraCuuPhieuCoc
TraCuuPhieuCoc o-- NhanVien
TraCuuPhieuCoc o-- PhieuCoc
HuyPhieuCoc o-- NhanVien
HuyPhieuCoc o-- HopDong
HuyPhieuCoc o-- PhieuCoc
HuyPhieuCoc o-- Phong
NhanVien o-down- NhanVienDB
HopDong o-down- HopDongDB
PhieuCoc o-down- PhieuCocDB
Phong o-down- PhongDB
PhieuCoc "0..*" -- "1" KhachHang : dai dien
PhieuCoc "0..*" -- "1" Phong : dat
PhieuCoc "1" -- "1..*" Giuong : gom
HuyPhieuCoc -[hidden]down- NhanVienDB
Phong -[hidden]down- NhanVienDB
@enduml
