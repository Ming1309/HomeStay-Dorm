@startuml
title SO DO LOP 3 TANG - QUAN LY PHONG GIUONG

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHQuanLyPhongGiuong {
    - rooms: PhongResponse[]
    - beds: GiuongResponse[]
    - roomTypes: LoaiPhongResponse[]
    - branches: ChiNhanhResponse[]
    - roomForm: RoomFormValues
    - bedForm: BedFormValues
    --
    + loadData()
    + openCreateRoom()
    + openEditRoom(room: PhongResponse)
    + openCreateBed()
    + openEditBed(bed: GiuongResponse)
    + submitRoom(values: RoomFormValues)
    + submitBed(values: BedFormValues)
    + confirmDelete()
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class QuanLyPhongGiuong {
    + LayDanhSachLoaiPhong(): IReadOnlyList<LoaiPhong>
    + LayDanhSachChiNhanh(): IReadOnlyList<ChiNhanh>
    + LayDanhSachPhong(text: String, maCN: String, toaNha: String, trangThai: String): IReadOnlyList<Phong>
    + LayChiTietPhong(maPhong: String): Phong
    + ThemPhong(phong: Phong): Phong
    + CapNhatPhong(maPhong: String, thongTin: Phong): Phong
    + XoaPhong(maPhong: String)
    + LayDanhSachGiuong(text: String, maPhong: String, trangThai: String): IReadOnlyList<Giuong>
    + LayChiTietGiuong(maGiuong: String): Giuong
    + ThemGiuong(giuong: Giuong): Giuong
    + CapNhatGiuong(maGiuong: String, thongTin: Giuong): Giuong
    + XoaGiuong(maGiuong: String)
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - TrangThai: String
    - MaLP: String
    - MaCN: String
    - LoaiPhong: LoaiPhong
    - Giuongs: List<Giuong>
    --
    + LayDanhSachQuanTri(text: String, maCN: String, toaNha: String, trangThai: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String): Phong
    + TrungSoPhong(maCN: String, soPhong: String, maPhongBoQua: String): Boolean
    + DangDuocThamChieu(maPhong: String): Boolean
    + ChuanHoa()
    + KiemTraDuLieuHopLe()
    + KiemTraCoTheXoa()
    + KiemTraSoGiuongKhongVuotSucChua(soGiuongHienCo: Integer)
    + KiemTraSucChuaChoDoiLoaiPhong(sucChuaMoi: Integer, soGiuongHienCo: Integer)
    + KiemTraDoiTrangThai(trangThaiMoi: String, giuongHienCo: IReadOnlyList<Giuong>, dangDuocThamChieu: Boolean)
    + Them()
    + CapNhatThongTin()
    + Xoa()
  }

  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
    - MaPhong: String
    --
    + LayDanhSachQuanTri(text: String, maPhong: String, trangThai: String): IReadOnlyList<Giuong>
    + DocChiTiet(maGiuong: String): Giuong
    + TrungSoGiuong(maPhong: String, soGiuong: String, maGiuongBoQua: String): Boolean
    + DangDuocThamChieu(maGiuong: String): Boolean
    + ChuanHoa()
    + KiemTraDuLieuHopLe()
    + KiemTraCoTheXoa()
    + KiemTraCoTheChuyenPhong(dangDuocThamChieu: Boolean)
    + KiemTraCoTheDoiSoGiuong(dangDuocThamChieu: Boolean)
    + KiemTraDoiTrangThai(trangThaiMoi: String, dangDuocThamChieu: Boolean)
    + Them()
    + CapNhatThongTin()
    + Xoa()
  }

  class LoaiPhong {
    - MaLP: String
    - TenLoaiPhong: String
    - SucChua: Integer
    - GiaThue: Decimal
    --
    + LayDanhSach(): IReadOnlyList<LoaiPhong>
    + LayTheoMa(maLP: String): LoaiPhong
  }

  class ChiNhanh {
    - MaCN: String
    - TenChiNhanh: String
    --
    + LayDanhSach(): IReadOnlyList<ChiNhanh>
    + TonTai(maCN: String): Boolean
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class PhongDB {
    + LayDanhSachQuanTri(text: String, maCN: String, toaNha: String, trangThai: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String): Phong
    + TrungSoPhong(maCN: String, soPhong: String, maPhongBoQua: String): Boolean
    + DangDuocThamChieu(maPhong: String): Boolean
    + Them(phong: Phong)
    + CapNhatThongTin(phong: Phong)
    + Xoa(maPhong: String)
  }

  class GiuongDB {
    + LayDanhSachQuanTri(text: String, maPhong: String, trangThai: String): IReadOnlyList<Giuong>
    + DocChiTiet(maGiuong: String): Giuong
    + TrungSoGiuong(maPhong: String, soGiuong: String, maGiuongBoQua: String): Boolean
    + DangDuocThamChieu(maGiuong: String): Boolean
    + Them(giuong: Giuong)
    + CapNhatThongTin(giuong: Giuong)
    + Xoa(maGiuong: String)
  }

  class LoaiPhongDB {
    + LayDanhSach(): IReadOnlyList<LoaiPhong>
    + LayTheoMa(maLP: String): LoaiPhong
  }

  class ChiNhanhDB {
    + LayDanhSach(): IReadOnlyList<ChiNhanh>
    + TonTai(maCN: String): Boolean
  }
}

MHQuanLyPhongGiuong o-- QuanLyPhongGiuong
QuanLyPhongGiuong o-- Phong
QuanLyPhongGiuong o-- Giuong
QuanLyPhongGiuong o-- LoaiPhong
QuanLyPhongGiuong o-- ChiNhanh

Phong "0..*" -- "1" LoaiPhong : thuoc
Phong "0..*" -- "1" ChiNhanh : thuoc
Phong "1" -- "0..*" Giuong : chua

Phong o-- PhongDB
Giuong o-- GiuongDB
LoaiPhong o-- LoaiPhongDB
ChiNhanh o-- ChiNhanhDB

@enduml
