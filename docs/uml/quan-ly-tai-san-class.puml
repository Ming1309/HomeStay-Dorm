@startuml
title SO DO LOP 3 TANG - QUAN LY TAI SAN (UC 1.4.30)
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHQuanLyTaiSan {
    - txtTimKiem: TextBox
    - cboLoaiTaiSan: ComboBox
    - cboTrangThai: ComboBox
    - tblTaiSan: Table
    - dlgTaiSan: Dialog
    + loadAssets()
    + onSubmit(values)
    + confirmDelete()
  }
}
package "TANG NGHIEP VU" #FCF3CF {
  class QuanLyTaiSan {
    + LayDanhSach(): List<TaiSan>
    + Them(taiSan: TaiSan): TaiSan
    + CapNhat(maTS: String, thongTin: TaiSan): TaiSan
    + Xoa(maTS: String)
  }
  class TaiSan {
    - MaTS: String
    - TenTaiSan: String
    - LoaiTaiSan: String
    - GiaTri: Decimal
    - MoTa: String
    - TrangThai: String
    + ChuanHoa()
    + KiemTraDuLieuHopLe()
    + LayDanhSach(): List<TaiSan>
    + Doc(maTS: String): TaiSan
    + TaoMaMoi(): String
    + TrungTen(tenTaiSan: String, maLoaiTru: String): Boolean
    + DangDuocThamChieu(maTS: String): Boolean
    + Them()
    + CapNhat()
    + Xoa()
  }
}
package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class TaiSanDB {
    + LayDanhSach(): List<TaiSan>
    + Doc(maTS: String): TaiSan
    + TaoMaMoi(): String
    + TrungTen(tenTaiSan: String, maLoaiTru: String): Boolean
    + DangDuocThamChieu(maTS: String): Boolean
    + Them(taiSan: TaiSan)
    + CapNhat(taiSan: TaiSan)
    + Xoa(maTS: String)
  }
}
MHQuanLyTaiSan o-- QuanLyTaiSan
QuanLyTaiSan o-- TaiSan
TaiSan o-- TaiSanDB
@enduml
