@startuml
title SO DO LOP 3 TANG - TRA CUU PHIEU COC
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}
package "TANG GIAO DIEN" #EAF2F8 {
  class MHTraCuuPhieuCoc {
    - txtMaPhieuCoc: TextBox
    - txtSDT: TextBox
    - txtEmail: TextBox
    - txtSoGiayTo: TextBox
    - grvKetQua: GridView
    - lblMaPhieuCoc: Label
    - lblTrangThai: Label
    - lblHoTenKhachHang: Label
    - lblSoDienThoai: Label
    - lblEmail: Label
    - lblSoGiayTo: Label
    - lblPhong: Label
    - lblHinhThucThue: Label
    - lblThoiDiemCoc: Label
    - lblTongTien: Label
    - lblTrangThaiThanhToan: Label
    - grvGiuongLienQuan: GridView
    - btnTimKiem: Button
    --
    + HienThi()
    + btnTimKiem_Click()
    + grvKetQua_CellClick(maPhieuCoc: String)
  }
}
package "TANG NGHIEP VU" #FCF3CF {
  class TraCuuPhieuCoc {
    + TimKiem(maPhieuCoc: String, sdt: String, email: String, soGiayTo: String): IReadOnlyList<PhieuCoc>
    + LayChiTiet(maPhieuCoc: String): PhieuCoc
  }

  class PhieuCoc {
    - MaPhieuCoc: String
    - HanThanhToan: DateTime
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - ThoiDiemCoc: DateTime
    - TrangThai: String
    - DaDongTien: Boolean
    --
    + TraCuu(maPhieuCoc: String, sdt: String, email: String, soGiayTo: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - SDT: String
    - Email: String
    - LoaiGiayTo: String
    - SoGiayTo: String
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
  }

  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
  }
}
package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class PhieuCocDB {
    + TraCuu(maPhieuCoc: String, sdt: String, email: String, soGiayTo: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
  }
}

MHTraCuuPhieuCoc o-- TraCuuPhieuCoc
TraCuuPhieuCoc o-- PhieuCoc
PhieuCoc o-- PhieuCocDB

PhieuCoc "0..*" -- "1" KhachHang : cua
PhieuCoc "0..*" -- "1" Phong : dat
PhieuCoc "1" -- "1..*" Giuong : gom
@enduml
