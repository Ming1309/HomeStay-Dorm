@startuml
title SO DO LOP 3 TANG - LAP PHIEU DANG KY

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHLapPhieuDangKy #BFE8BA {
    - txtHoTen: TextBox
    - txtSoGiayTo: TextBox
    - txtKhuVuc: TextBox
    - btnLuu: Button
    --
    + HienThi()
    + lapPhieuDangKy()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class LapPhieuDangKy #F4E3A2 {
    + LayKhuVucDangKy(maNV: String): IReadOnlyList<String>
    + TaoPhieuDangKy(hoTen: String, gioiTinh: String, sdt: String, email: String,\n  loaiGiayTo: String, soGiayTo: String, khuVuc: String, soLuongNguoi: Integer,\n  loaiDichVu: String, mucGia: Decimal, thoiGianDuKienVao: DateTime,\n  thoiHanThue: Integer, yeuCauKhac: String, maNV: String): PhieuDangKy
  }
  class NhanVien #F4E3A2 {
    + DocPhamVi(maNV: String): NhanVien
  }
  class KhachHang #F4E3A2 {
    + KiemTraTonTai(soGiayTo: String): KhachHang
    + TaoMoi(hoTen: String, gioiTinh: String, sdt: String, email: String, diaChiThuongTru: String, loaiGiayTo: String, soGiayTo: String): KhachHang
    + Them()
  }
  class PhieuDangKy #F4E3A2 {
    + TaoMoi(maKH: String, maNV: String, maCN: String, khuVuc: String,\n  soLuongNguoi: Integer, loaiDichVu: String, mucGia: Decimal,\n  thoiGianDuKienVao: DateTime, thoiHanThue: Integer,\n  yeuCauKhac: String, thoiDiem: DateTime): PhieuDangKy
    + KiemTraDieuKien(thoiDiemHienTai: DateTime)
    + Them()
  }
  class Phong #F4E3A2 {
    + LocPhongTheoTieuChi(toaNha: String, tang: String, maLP: String, maCN: String,\n  trangThai: String, giaMin: Decimal, giaMax: Decimal): IReadOnlyList<Phong>
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class NhanVienDB #BFDCF0 {
    + DocChiTiet(maNV: String): NhanVien
  }
  class KhachHangDB #BFDCF0 {
    + TimTheoSoGiayTo(soGiayTo: String): KhachHang
    + Them(khachHang: KhachHang)
  }
  class PhieuDangKyDB #BFDCF0 {
    + Them(phieu: PhieuDangKy)
  }
  class PhongDB #BFDCF0 {
    + LayPhongTheoBoLoc(toaNha: String, tang: String, maLP: String, maCN: String,\n  trangThai: String, giaMin: Decimal, giaMax: Decimal): IReadOnlyList<Phong>
  }
}

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
MHLapPhieuDangKy o-down- LapPhieuDangKy
LapPhieuDangKy o-- NhanVien
LapPhieuDangKy o-- KhachHang
LapPhieuDangKy o-- PhieuDangKy
LapPhieuDangKy o-- Phong
NhanVien o-down- NhanVienDB
KhachHang o-down- KhachHangDB
PhieuDangKy o-down- PhieuDangKyDB
Phong o-down- PhongDB
LapPhieuDangKy -[hidden]down- NhanVienDB
Phong -[hidden]down- NhanVienDB
@enduml
