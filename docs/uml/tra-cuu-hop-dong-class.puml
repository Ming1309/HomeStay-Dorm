@startuml
title SO DO LOP 3 TANG - TRA CUU HOP DONG

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHTraCuuHopDong #BFE8BA {
    - txtTuKhoa: TextBox
    - cbTrangThai: ComboBox
    - btnTimKiem: Button
    - grvDSHopDong: DataGridView
    - lblThongTinHopDong: Label
    - grvKhoanThuHangThang: DataGridView
    - grvThanhVien: DataGridView
    - btnXemChiTietThanhVien: Button
    --
    + HienThi()
    + btnTimKiem_Click()
    + grvDSHopDong_CellClick(maHD: String)
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class TraCuuHopDong #F4E3A2 {
    + TimKiem(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayChiTiet(maHD: String): HopDong
  }

  class HopDong #F4E3A2 {
    - MaHD: String
    - NgayKy: DateTime
    - NgayBatDau: DateTime
    - NgayKetThuc: DateTime
    - KyThanhToan: Integer
    - GiaThue: Decimal
    - TrangThai: String
    - MaPhieuCoc: String
    - TienCoc: Decimal
    --
    + TimKiem(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayDanhSachHieuLuc(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
  }

  class ThanhVienHopDong #F4E3A2 {
    - MaHD: String
    - MaGiuong: String
    - MaKH: String
    - TrangThaiThue: String
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
  }

  class DichVuHopDong #F4E3A2 {
    - MaHD: String
    - MaDV: String
    - DonGiaKyKet: Decimal
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }

  class KhachHang #F4E3A2 {
    - MaKH: String
    - HoTen: String
    - SDT: String
    - SoGiayTo: String
  }

  class Phong #F4E3A2 {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
  }

  class DichVu #F4E3A2 {
    - MaDV: String
    - TenDV: String
    - DonGia: Decimal
    - DonViTinh: String
  }

  class Giuong #F4E3A2 {
    - MaGiuong: String
    - SoGiuong: String
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class HopDongDB #BFDCF0 {
    + TraCuu(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayDanhSachHieuLuc(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
  }

  class ThanhVienHopDongDB #BFDCF0 {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
  }

  class DichVuHopDongDB #BFDCF0 {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }
}

MHTraCuuHopDong o-- TraCuuHopDong

TraCuuHopDong o-- HopDong
TraCuuHopDong o-- ThanhVienHopDong
TraCuuHopDong o-- DichVuHopDong

HopDong o-- HopDongDB
ThanhVienHopDong o-- ThanhVienHopDongDB
DichVuHopDong o-- DichVuHopDongDB

HopDong -- KhachHang
HopDong -- Phong
HopDong -- ThanhVienHopDong
HopDong -- DichVuHopDong
ThanhVienHopDong -- KhachHang
ThanhVienHopDong -- Giuong
DichVuHopDong -- DichVu


GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
TraCuuHopDong -[hidden]down- HopDongDB
Giuong -[hidden]down- HopDongDB
@enduml
