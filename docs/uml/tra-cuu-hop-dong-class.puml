@startuml
title SO DO LOP 3 TANG - TRA CUU HOP DONG

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHTraCuuHopDong {
    - txtTuKhoa: TextBox
    - cbTrangThai: ComboBox
    - btnTimKiem: Button
    - grvDSHopDong: DataGridView
    - lblThongTinHopDong: Label
    - grvKhoanThuHangThang: DataGridView
    - grvThanhVien: DataGridView
    - btnXemChiTietThanhVien: Button
    --
    + HienThi()
    + btnTimKiem_Click()
    + grvDSHopDong_CellClick(maHD: String)
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class TraCuuHopDong {
    + TimKiem(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayChiTiet(maHD: String): HopDong
  }

  class HopDong {
    - MaHD: String
    - NgayKy: DateTime
    - NgayBatDau: DateTime
    - NgayKetThuc: DateTime
    - KyThanhToan: Integer
    - GiaThue: Decimal
    - TrangThai: String
    - MaPhieuCoc: String
    - TienCoc: Decimal
    --
    + TimKiem(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayDanhSachHieuLuc(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
  }

  class ThanhVienHopDong {
    - MaHD: String
    - MaGiuong: String
    - MaKH: String
    - TrangThaiThue: String
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
  }

  class DichVuHopDong {
    - MaHD: String
    - MaDV: String
    - DonGiaKyKet: Decimal
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - SDT: String
    - SoGiayTo: String
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
  }

  class DichVu {
    - MaDV: String
    - TenDV: String
    - DonGia: Decimal
    - DonViTinh: String
  }

  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class HopDongDB {
    + TraCuu(tuKhoa: String, trangThai: String): IReadOnlyList<HopDong>
    + LayDanhSachHieuLuc(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
  }

  class ThanhVienHopDongDB {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
  }

  class DichVuHopDongDB {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }
}

MHTraCuuHopDong o-- TraCuuHopDong

TraCuuHopDong o-- HopDong
TraCuuHopDong o-- ThanhVienHopDong
TraCuuHopDong o-- DichVuHopDong

HopDong o-- HopDongDB
ThanhVienHopDong o-- ThanhVienHopDongDB
DichVuHopDong o-- DichVuHopDongDB

HopDong -- KhachHang
HopDong -- Phong
HopDong -- ThanhVienHopDong
HopDong -- DichVuHopDong
ThanhVienHopDong -- KhachHang
ThanhVienHopDong -- Giuong
DichVuHopDong -- DichVu

@enduml
