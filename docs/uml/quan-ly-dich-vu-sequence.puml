@startuml
title SO DO TUAN TU - QUAN LY DICH VU (UC 1.4.26)
hide footbox
autonumber 1 1
skinparam shadowing false
actor "Quan tri vien" as QTV

box "GUI" #D5F5D3
boundary ": MHQuanLyDichVu" as MH
end box

box "BUS" #FCF3CF
control ": QuanLyDichVu" as QL
control ": DichVu" as DV
end box

box "DB" #D6EAF8
entity ": DichVuDB" as DB
end box

QTV -> MH : Mo man hinh chuc nang
activate MH
MH -> MH : taiDanhSachDichVu()
MH -> QL : LayDanhSach()
activate QL
QL -> DV : LayDanhSach()
activate DV
DV -> DB : LayDanhSach()
activate DB
deactivate DB
deactivate DV
deactivate QL
MH -> MH : hien thi danh sach

QTV -> MH : Nhap thong tin va nhan "Luu"
MH -> MH : luuDichVu(dichVu)
MH -> MH : validate form
alt them moi
  MH -> QL : Them(dichVu)
  activate QL
  QL -> DV : ChuanHoa()
  activate DV
deactivate DV
  QL -> DV : KiemTraDuLieuHopLe()
  activate DV
deactivate DV
  QL -> DV : Them()
  activate DV
  DV -> DB : Them(dichVu)
  activate DB
deactivate DB
deactivate DV
deactivate QL
else cap nhat
  MH -> QL : CapNhat(maDV, thongTin)
  activate QL
  QL -> DV : ChuanHoa()
  activate DV
deactivate DV
  QL -> DV : KiemTraDuLieuHopLe()
  activate DV
deactivate DV
  QL -> DV : Doc(maDV)
  activate DV
  DV -> DB : Doc(maDV)
  activate DB
deactivate DB
deactivate DV
  QL -> DV : CapNhat()
  activate DV
  DV -> DB : CapNhat(dichVu)
  activate DB
deactivate DB
deactivate DV
deactivate QL
end

QTV -> MH : Chon ban ghi va xac nhan xoa
MH -> MH : xacNhanXoa()
MH -> QL : Xoa(maDV)
activate QL
QL -> DV : Doc(maDV)
activate DV
DV -> DB : Doc(maDV)
activate DB
deactivate DB
deactivate DV
QL -> DV : DangDuocThamChieu(maDV)
activate DV
DV -> DB : DangDuocThamChieu(maDV)
activate DB
alt da duoc tham chieu
deactivate DB
deactivate DV
  QL -> QL : throw InvalidOperationException
else chua duoc tham chieu
  QL -> DV : Xoa()
  activate DV
  DV -> DB : Xoa(maDV)
  activate DB
end
deactivate DB
deactivate DV
deactivate QL
deactivate MH
@enduml
