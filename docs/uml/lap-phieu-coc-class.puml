@startuml
title SO DO LOP 3 TANG - LAP PHIEU COC

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHLapPhieuCoc {
    - txtTimKiemKH: TextBox
    - grvKhachChoCoc: GridView
    - txtHoTen: TextBox
    - txtSDT: TextBox
    - dtpNgaySinh: DatePicker
    - lstGioiTinh: ListBox
    - lstLoaiGiayTo: ListBox
    - txtQuocTich: TextBox
    - txtEmail: TextBox
    - txtSoGiayTo: TextBox
    - rdoThueOGhep: RadioButton
    - rdoThueNguyenPhong: RadioButton
    - txtSoLuongGiuong: TextBox
    - lstToaNha: ListBox
    - lstLoaiPhong: ListBox
    - txtGiaMin: TextBox
    - txtGiaMax: TextBox
    - grvDanhSachPhong: GridView
    - grvDanhSachGiuong: GridView
    - btnChinhSua: Button
    - btnTimKiem: Button
    - btnTaoYeuCauCoc: Button
    - dlgXacNhanTaoPhieu: AlertDialog
    - lblTienCocTamTinh: Label
    --
    + HienThi()
    + selectAppointment(lichHen: LichHen)
    + changeRentalType(hinhThucThue: String)
    + searchRooms()
    + selectWholeRoom(phong: Phong)
    + toggleBed(phong: Phong, maGiuong: String)
    + openConfirmation()
    + submitDeposit()
  }

}

package "TANG NGHIEP VU" #FCF3CF {
  class LapPhieuCoc {
    + LayDanhSachKhachChoCoc(maNV: String): IReadOnlyList<LichHen>
    + TimKiemKhachChoCoc(text: String, maNV: String): IReadOnlyList<LichHen>
    + LayChiTietLichHen(maLichHen: String, maNV: String): LichHen
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, gioiTinh: String, maNV: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, gioiTinh: String, maNV: String): IReadOnlyList<Phong>
    + TaoPhieuCoc(maLichHen: String, thongTinKhachHang: KhachHang, maPhong: String, danhSachGiuong: IEnumerable<String>, hinhThucThue: String, maNhanVien: String): PhieuCoc
  }

  class NhanVien {
    - MaNV: String
    - MaCN: String
    - VaiTro: String
    --
    + DocPhamVi(maNV: String): NhanVien
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - NgaySinh: DateTime
    - GioiTinh: String
    - QuocTich: String
    - LoaiGiayTo: String
    - SoGiayTo: String
    - DiaChiThuongTru: String
    - SDT: String
    - Email: String
    --
    + CapNhatTu(thongTinMoi: KhachHang): Boolean
    + CapNhat()
  }

  class LichHen {
    - MaLH: String
    - NgayHen: DateTime
    - GioHen: TimeSpan
    - LoaiLichHen: String
    - TrangThai: String
    - MaPDK: String
    - MaPhieuCoc: String
    - KhachHang: KhachHang
    --
    + LayDanhSachKhachChoCoc(maCN: String): IReadOnlyList<LichHen>
    + LayDanhSachKhachChoCoc(maCN: String, text: String): IReadOnlyList<LichHen>
    + DocChiTiet(maLichHen: String, maCN: String, khoaCapNhat: Boolean): LichHen
    + KiemTraCoTheLapPhieuCoc()
    + GanPhieuCoc(maPhieuCoc: String)
    + LuuPhieuCoc()
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - Tang: String
    - GioiTinhChoPhep: String
    - TrangThai: String
    - MaCN: String
    - SoGiuongTrong: Integer
    - GiuongsVuaGiu: IReadOnlyList<Giuong>
    --
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String, maCN: String): Phong
    + KiemTraGioiTinhChoPhep(dsKhach: IReadOnlyList<KhachHang>): Boolean
    + GiuGiuong(maGiuongs: IEnumerable<String>): IReadOnlyList<Giuong>
    + GiuNguyenPhong(): IReadOnlyList<Giuong>
    + TinhTienCoc(soGiuong: Integer): Decimal
    + PhuHopYeuCau(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal): Boolean
    + CapNhat()
  }

  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
    - MaPhong: String
    --
    + GiuCho(maPhong: String)
  }

  class LoaiPhong {
    - MaLP: String
    - TenLoaiPhong: String
    - SucChua: Integer
    - GiaThue: Decimal
  }

  class PhieuCoc {
    - MaPhieuCoc: String
    - HanThanhToan: DateTime
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - TrangThai: String
    --
    + TaoMoi(hinhThucThue: String, khachHang: KhachHang, phong: Phong, giuongs: IReadOnlyList<Giuong>, maNhanVien: String, thoiDiem: DateTime): PhieuCoc
    + Them()
  }

  class ThanhVienDangKy {
    - MaPhieuCoc: String
    - MaKH: String
    - VaiTro: String
    - TrangThaiDuyet: String
  }

  class DichVuThongBao {
    + PhatCanXuLyTheoVaiTro(loaiSuKien: String, maCN: String, vaiTroNhan: String, tieuDe: String, noiDung: String, lienKet: String, maThamChieu: String, maNVGui: String)
  }

  class ThongBao {
    + Tao(loaiSuKien: String, loaiThongBao: String, tieuDe: String, noiDung: String, maCN: String, vaiTroNhan: String, maNVNhan: String, lienKet: String, tone: String, khoaChongTrung: String, maNVGui: String, maThamChieu: String, thoiGianTao: DateTime): ThongBao
    + Luu()
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {

  class LichHenDB {
    + LayDanhSachKhachChoCoc(maCN: String): IReadOnlyList<LichHen>
    + LayDanhSachKhachChoCoc(maCN: String, text: String): IReadOnlyList<LichHen>
    + DocChiTiet(maLichHen: String, maCN: String, khoaCapNhat: Boolean): LichHen
    + GanPhieuCoc(lichHen: LichHen)
  }

  class KhachHangDB {
    + CapNhat(khachHang: KhachHang)
  }

  class PhongDB {
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String, maCN: String): Phong
    + CapNhat(phong: Phong)
  }

  class PhieuCocDB {
    + Them(phieu: PhieuCoc)
  }

  class NhanVienDB {
    + DocChiTiet(maNV: String): NhanVien
  }

  class ThongBaoDB {
    + Them(thongBao: ThongBao, capNhatNeuTonTai: Boolean)
  }
}

' Boundary dieu khien use case lap phieu coc.
MHLapPhieuCoc  o--  LapPhieuCoc

' Trong BLL: duong thang, khong huong.
LapPhieuCoc "1" -- "0..*" LichHen : xu ly
LapPhieuCoc "1" -- "0..*" KhachHang : cap nhat
LapPhieuCoc "1" -- "0..*" Phong : xu ly
LapPhieuCoc "1" -- "0..*" PhieuCoc : lap
LapPhieuCoc "1" -- "1" NhanVien : doc pham vi
LapPhieuCoc "1" -- "1" DichVuThongBao : phat tac vu
LichHen "0..*" -- "1" KhachHang : dat lich
LichHen "1" -- "0..1" PhieuCoc : gan coc
Phong "0..*" -- "1" LoaiPhong : thuoc
Phong "1" -- "1..*" Giuong : chua
PhieuCoc "0..*" -- "1" KhachHang : dai dien
PhieuCoc "0..*" -- "1" Phong : dat
PhieuCoc "0..*" -- "1..*" Giuong : chi tiet
PhieuCoc "1" -- "1..*" ThanhVienDangKy : gom
DichVuThongBao "1" -- "0..*" ThongBao : tao

' Aggregation giua business va data access.
LichHen  o--  LichHenDB
KhachHang  o--  KhachHangDB
Phong  o--  PhongDB
PhieuCoc  o-- PhieuCocDB
NhanVien o-- NhanVienDB
ThongBao o-- ThongBaoDB

@enduml
