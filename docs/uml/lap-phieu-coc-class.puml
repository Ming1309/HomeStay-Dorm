@startuml
title SO DO LOP 3 TANG - LAP PHIEU COC

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHLapPhieuCoc #BFE8BA {
    - txtTimKiemLichHen: TextBox
    - grvLichHenChoCoc: GridView
    - lblSoLichHen: Label
    - txtHoTen: TextBox
    - txtSDT: TextBox
    - dtpNgaySinh: DatePicker
    - lstGioiTinh: ListBox
    - txtQuocTich: TextBox
    - txtEmail: TextBox
    - lstLoaiGiayTo: ListBox
    - txtSoGiayTo: TextBox
    - rdoThueOGhep: RadioButton
    - rdoThueNguyenPhong: RadioButton
    - txtSoLuongGiuong: TextBox
    - lstToaNha: ListBox
    - lstLoaiPhong: ListBox
    - txtGiaMin: TextBox
    - txtGiaMax: TextBox
    - grvDanhSachPhong: GridView
    - grvDanhSachGiuong: GridView
    - lblSoPhongPhuHop: Label
    - btnChinhSua: Button
    - btnTimPhong: Button
    - btnTaoPhieuCoc: Button
    - dlgXacNhanTaoPhieu: AlertDialog
    - lblTienCocTamTinh: Label
    --
    + HienThi()
    + timKiemLichHen(text: String)
    + chonLichHen(lichHen: LichHen)
    + chonHinhThucThue(hinhThucThue: String)
    + timPhong()
    + chonNguyenPhong(phong: Phong)
    + chonBoChonGiuong(phong: Phong, maGiuong: String)
    + moHopThoaiXacNhan()
    + taoPhieuCoc()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class LapPhieuCoc #F4E3A2 {
    + LayDanhSachKhachChoCoc(maNV: String): IReadOnlyList<LichHen>
    + TimKiemKhachChoCoc(text: String, maNV: String): IReadOnlyList<LichHen>
    + LayChiTietLichHen(maLichHen: String, maNV: String): LichHen
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, gioiTinh: String, maNV: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, gioiTinh: String, maNV: String): IReadOnlyList<Phong>
    + TaoPhieuCoc(maLichHen: String, thongTinKhachHang: KhachHang, maPhong: String, danhSachGiuong: IEnumerable<String>, hinhThucThue: String, maNhanVien: String): PhieuCoc
    - KiemTraThongTinKhachHang(khachHang: KhachHang)
  }

  class NhanVien #F4E3A2 {
    - MaNV: String
    - MaCN: String
    - ThanhViens: List<ThanhVienDangKy>
    - VaiTro: String
    --
    + DocPhamVi(maNV: String): NhanVien
  }

  class LichHen #F4E3A2 {
    - MaLH: String
    - NgayHen: DateTime
    - GioHen: TimeSpan
    - LoaiLichHen: String
    - TrangThai: String
    - MaPDK: String
    - MaPhieuCoc: String
    - MaCN: String
    - KhachHang: KhachHang
    --
    + LayDanhSachKhachChoCoc(maCN: String, text: String = ""): IReadOnlyList<LichHen>
    + DocChiTiet(maLichHen: String, maCN: String, khoaCapNhat: Boolean): LichHen
    + KiemTraCoTheLapPhieuCoc()
    + GanPhieuCoc(maPhieuCoc: String)
    + LuuPhieuCoc()
  }

  class KhachHang #F4E3A2 {
    - MaKH: String
    - HoTen: String
    - NgaySinh: DateTime
    - GioiTinh: String
    - QuocTich: String
    - LoaiGiayTo: String
    - SoGiayTo: String
    - SDT: String
    - Email: String
    --
    + CapNhatTu(thongTinMoi: KhachHang): Boolean
    + CapNhat()
  }

  class Phong #F4E3A2 {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - Tang: String
    - GioiTinhChoPhep: String
    - TrangThai: String
    - MaCN: String
    - Giuongs: List<Giuong>
    --
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String, maCN: String): Phong
    + KiemTraGioiTinhChoPhep(dsKhach: IReadOnlyList<KhachHang>): Boolean
    + GiuGiuong(maGiuongs: IEnumerable<String>): IReadOnlyList<Giuong>
    + GiuNguyenPhong(): IReadOnlyList<Giuong>
    + CapNhat()
  }

  class Giuong #F4E3A2 {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
    - MaPhong: String
    --
    + GiuCho(maPhong: String)
  }

  class LoaiPhong #F4E3A2 {
    - MaLP: String
    - TenLoaiPhong: String
    - SucChua: Integer
    - GiaThue: Decimal
  }

  class PhieuCoc #F4E3A2 {
    - MaPhieuCoc: String
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - ThoiDiemCoc: DateTime
    - TrangThai: String
    - MaKH: String
    - MaPhong: String
    - MaNV: String
    - MaCN: String
    --
    + TaoMoi(hinhThucThue: String, khachHang: KhachHang, phong: Phong, giuongs: IReadOnlyList<Giuong>, maNhanVien: String, thoiDiem: DateTime): PhieuCoc
    + Them()
  }

  class ThanhVienDangKy #F4E3A2 {
    - MaPhieuCoc: String
    - MaKH: String
    - VaiTro: String
    - TrangThaiDuyet: String
  }

}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class NhanVienDB #BFDCF0 {
    + DocChiTiet(maNV: String): NhanVien
  }

  class LichHenDB #BFDCF0 {
    + LayDanhSachKhachChoCoc(maCN: String, text: String = ""): IReadOnlyList<LichHen>
    + DocChiTiet(maLichHen: String, maCN: String, khoaCapNhat: Boolean): LichHen
    + GanPhieuCoc(lichHen: LichHen)
  }

  class KhachHangDB #BFDCF0 {
    + CapNhat(khachHang: KhachHang)
  }

  class PhongDB #BFDCF0 {
    + LayPhongOGhep(soLuong: Integer, toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + LayPhongNguyenCan(toaNha: String, loaiPhong: String, giaMin: Decimal, giaMax: Decimal, maCN: String, gioiTinh: String): IReadOnlyList<Phong>
    + DocChiTiet(maPhong: String, maCN: String): Phong
    + CapNhat(phong: Phong)
  }

  class PhieuCocDB #BFDCF0 {
    + Them(phieu: PhieuCoc)
  }

  NhanVienDB -[hidden]right- LichHenDB
  LichHenDB -[hidden]right- KhachHangDB
  KhachHangDB -[hidden]right- PhieuCocDB
  PhieuCocDB -[hidden]right- PhongDB
}

' Co dinh thu tu ba tang theo chieu doc.
GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER

' Neo lop o hang thap nhat cua BUS voi lop trung tam cua DAL.
' Rang buoc truc tiep nay buoc toan bo DAL nam duoi BUS.
Giuong -[hidden]down- PhieuCocDB

' Ep bo cuc theo tung hang de han che duong noi giao nhau.
NhanVien -[hidden]right- LichHen
KhachHang -[hidden]right- PhieuCoc
PhieuCoc -[hidden]right- Phong
ThanhVienDangKy -[hidden]right- Giuong
Giuong -[hidden]right- LoaiPhong

' Boundary va control cua use case.
MHLapPhieuCoc o-down- LapPhieuCoc
LapPhieuCoc o-down- NhanVien
LapPhieuCoc o-down- LichHen
LapPhieuCoc o-down- KhachHang
LapPhieuCoc o-down- PhieuCoc
LapPhieuCoc o-down- Phong

' Quan he nghiep vu thuc su; bo nhan tren duong noi de so do gon hon.
LichHen "0..*" -left- "1" KhachHang
LichHen "1" -down- "0..1" PhieuCoc
PhieuCoc "0..*" -left- "1" KhachHang
PhieuCoc "0..*" -right- "1" Phong
PhieuCoc "0..*" -down- "1..*" Giuong
PhieuCoc "1" -down- "1..*" ThanhVienDangKy
Phong "0..*" -down- "1" LoaiPhong
Phong "1" -down- "1..*" Giuong

' Moi lop nghiep vu truy cap DB cua chinh no.
NhanVien o-down- NhanVienDB
LichHen o-down- LichHenDB
KhachHang o-down- KhachHangDB
PhieuCoc o-down- PhieuCocDB
Phong o-down- PhongDB

@enduml
