@startuml
title SO DO LOP 3 TANG - LAP PHIEU HOAN COC
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHHoanCoc {
    + fetchQueue()
    + fetchDetails(maPDS: String)
    + handleSubmit(values: RefundFormValues)
  }
}
package "TANG NGHIEP VU" #FCF3CF {
  class LapPhieuHoanCoc {
    + LayDSPhieuDoiSoatCanHoan(): IReadOnlyList<DoiSoatChoHoanCocDto>
    + LayChiTietPhieuDoiSoatDto(maPDS: String): ChiTietHoanCocDto
    + ThucHienHoanCoc(maPDS: String, phuongThuc: String, thongTinNhanTien: String, maGiaoDich: String, minhChung: String, maNV: String): PhieuHoanCoc
  }
  class PhieuDoiSoat {
    - TienHoan: Decimal
    - TrangThai: String
    + LayDSPhieuDoiSoatCanHoan(): IReadOnlyList<PhieuDoiSoat>
    + LayChiTietPhieuDoiSoat(maPDS: String): PhieuDoiSoat
    + LayChiTietChoCapNhat(maPDS: String): PhieuDoiSoat
    + ChuyenSangDaTatToan(maPDS: String)
  }
  class PhieuHoanCoc {
    - MaGiaoDich: String
    - MinhChung: String
    + TaoPhieuHoanCoc(maPDS: String, soTien: Decimal, phuongThuc: String, thongTinNhanTien: String, maGiaoDich: String, minhChung: String, maNV: String, thoiDiem: DateTime): PhieuHoanCoc
    + DaTonTaiChoPhieuDoiSoat(maPDS: String): Boolean
    + LuuPhieu()
  }
}
package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class PhieuDoiSoatDB {
    + GetDSPhieuDoiSoatCanHoan(): IReadOnlyList<PhieuDoiSoat>
    + GetPhieuDoiSoatChoCapNhat(maPDS: String): PhieuDoiSoat
    + UpdateTrangThai(maPDS: String, trangThaiHienTai: String, trangThaiMoi: String): Boolean
  }
  class PhieuHoanCocDB {
    + TonTaiTheoMaPhieuDoiSoat(maPDS: String): Boolean
    + InsertPhieuHoanCoc(phieu: PhieuHoanCoc)
  }
}
MHHoanCoc o-- LapPhieuHoanCoc
LapPhieuHoanCoc o-- PhieuDoiSoat
LapPhieuHoanCoc o-- PhieuHoanCoc
PhieuDoiSoat o-- PhieuDoiSoatDB
PhieuHoanCoc o-- PhieuHoanCocDB
@enduml
