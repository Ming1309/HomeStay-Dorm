@startuml
title SO DO LOP 3 TANG - LAP PHIEU HOAN COC
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHHoanCoc #BFE8BA {
    - txtTimKiemPhieu: TextBox
    - grvPhieuDoiSoatChoHoan: GridView
    - lblMaPDS: Label
    - lblMaPhieuCoc: Label
    - lblHoTenKhachHang: Label
    - lblSoDienThoai: Label
    - lblPhong: Label
    - lblTienCocBanDau: Label
    - lblTyLeHoanCoc: Label
    - lblTienHoanCoBan: Label
    - lblTongKhauTru: Label
    - lblTienHoan: Label
    - lstPhuongThucHoan: ListBox
    - txtSoTaiKhoan: TextBox
    - txtNganHang: TextBox
    - txtChuTaiKhoan: TextBox
    - txtMaGiaoDich: TextBox
    - txtNguoiNhan: TextBox
    - uplMinhChung: FileUpload
    - btnLapPhieuHoanCoc: Button
    - dlgHoanTat: Dialog
    --
    + taiDanhSachChoHoan()
    + taiChiTiet(maPDS: String)
    + lapPhieuHoanCoc()
  }
}
package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class LapPhieuHoanCoc #F4E3A2 {
    + LayDSPhieuDoiSoatCanHoan()
    + LayChiTietPhieuDoiSoatDto(maPDS: String)
    + ThucHienHoanCoc(maPDS: String, phuongThuc: String, thongTinNhanTien: String, maGiaoDich: String, minhChung: String, maNV: String): PhieuHoanCoc
  }
  class PhieuDoiSoat #F4E3A2 {
    - TienHoan: Decimal
    - TrangThai: String
    + LayDSPhieuDoiSoatCanHoan(): IReadOnlyList<PhieuDoiSoat>
    + LayChiTietPhieuDoiSoat(maPDS: String): PhieuDoiSoat
    + LayChiTietChoCapNhat(maPDS: String): PhieuDoiSoat
    + ChuyenSangDaTatToan(maPDS: String)
  }
  class PhieuHoanCoc #F4E3A2 {
    - MaGiaoDich: String
    - MinhChung: String
    + TaoPhieuHoanCoc(maPDS: String, soTien: Decimal, phuongThuc: String, thongTinNhanTien: String, maGiaoDich: String, minhChung: String, maNV: String, thoiDiem: DateTime): PhieuHoanCoc
    + DaTonTaiChoPhieuDoiSoat(maPDS: String): Boolean
    + LuuPhieu()
  }
}
package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class PhieuDoiSoatDB #BFDCF0 {
    + GetDSPhieuDoiSoatCanHoan(): IReadOnlyList<PhieuDoiSoat>
    + GetPhieuDoiSoatTheoMaPDS(maPDS: String): PhieuDoiSoat
    + GetPhieuDoiSoatChoCapNhat(maPDS: String): PhieuDoiSoat
    + UpdateTrangThai(maPDS: String, trangThaiHienTai: String, trangThaiMoi: String): Boolean
  }
  class PhieuHoanCocDB #BFDCF0 {
    + TonTaiTheoMaPhieuDoiSoat(maPDS: String): Boolean
    + InsertPhieuHoanCoc(phieu: PhieuHoanCoc)
  }
}
MHHoanCoc o-- LapPhieuHoanCoc
LapPhieuHoanCoc o-- PhieuDoiSoat
LapPhieuHoanCoc o-- PhieuHoanCoc
PhieuDoiSoat o-- PhieuDoiSoatDB
PhieuHoanCoc o-- PhieuHoanCocDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
LapPhieuHoanCoc -[hidden]down- PhieuDoiSoatDB
@enduml
