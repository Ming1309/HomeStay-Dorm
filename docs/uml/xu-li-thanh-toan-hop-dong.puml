@startuml
title SO DO LOP 3 TANG - XU LY THANH TOAN HOP DONG

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHXuLyThanhToanHopDong {
    - txtTimKiemHopDong: TextBox
    - pnlDanhSachHopDong: Panel
    - cardHopDong: Panel
    - lblMaHopDongCard: Label
    - lblTenKhachCard: Label
    - lblPhongCard: Label
    - lblTongTienCard: Label
    - badgeChoThanhToanCard: Label
    - lblMaHopDongDangChon: Label
    - badgeChoThanhToan: Label
    - lblTenKhachDangChon: Label
    - lblPhongDangChon: Label
    - lblTongCanThanhToan: Label
    - dgvKhoanThu: DataGridView
    - colKhoanThu: DataGridViewColumn
    - colSoLuongKy: DataGridViewColumn
    - colThanhTien: DataGridViewColumn
    - lblTongCongHoaDon: Label
    - lblTongConLaiCanThu: Label
    - btnTienHanhThuTien: Button
    --
    + loadHangDoiThuTien()
    + timKiemHopDong()
    + clickChonHopDong()
    + hienThiChiTietThanhToan()
    + hienThiBangKhoanThu()
    + hienThiTongTien()
    + clickTienHanhThuTien()
    + hienThiThongBao()
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class XuLyThanhToanHopDong {
    + LayDSChoThanhToan(): IReadOnlyList<HopDongDto>
    + LayChiTietThanhToan(maHD: String): ChiTietThanhToanDto
    + TienHanhThuTien(maHD: String, phuongThuc: String, anhMinhChung: String, maNV: String): PhieuThu
  }

  class HopDong {
    - MaHD: String
    - NgayKy: DateTime
    - NgayBatDau: DateTime
    - NgayKetThuc: DateTime
    - KyThanhToan: Integer
    - GiaThue: Decimal
    - DieuKhoan: String
    - TrangThai: String
    - MaNV: String
    - MaPhieuCoc: String
    - MaChinhSach: String
    - MaQLDuyet: String
    --
    + LayDanhSachChoThanhToan(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
    + KiemTraChoThanhToan()
    + CapNhatTrangThaiChoBanGiao(maHD: String)
  }

  class HoaDon {
    - MaHoaDon: String
    - NgayLap: DateTime
    - HanThanhToan: DateTime
    - LoaiHoaDon: String
    - TongTien: Decimal
    - TrangThai: String
    - GhiChu: String
    - MaHD: String
    - MaNV: String
    --
    + TinhTongTienKyDau(dsChiTiet: IReadOnlyList<ChiTietHoaDon>): Decimal
    + TaoHoaDonKyDauDaThanhToan(maHD: String, tongTien: Decimal, maNV: String, ngayLap: DateTime, dsChiTiet: IReadOnlyList<ChiTietHoaDon>): HoaDon
    + KiemTraChuaCoHoaDonKyDau(maHD: String): Boolean
  }

  class ChiTietHoaDon {
    - MaHoaDon: String
    - STT: Integer
    - LoaiKhoanThu: String
    - MaDV: String
    - MaTS: String
    - MaGiuong: String
    - SoLuong: Decimal
    - DonViTinh: String
    - DonGia: Decimal
    - ThanhTien: Decimal
    --
    + TaoDongTienThueKyDau(maHoaDon: String, stt: Integer, donGia: Decimal, soLuong: Integer): ChiTietHoaDon
    + TaoDongDichVu(maHoaDon: String, dichVus: IReadOnlyList<DichVuHopDong>, sttBatDau: Integer): List<ChiTietHoaDon>
    + LuuDanhSachChiTietHoaDon(dsChiTiet: IReadOnlyList<ChiTietHoaDon>)
  }

  class PhieuThu {
    - MaPT: String
    - SoTienThu: Decimal
    - ThoiGian: DateTime
    - PhuongThucThanhToan: String
    - AnhMinhChung: String
    - MaHoaDon: String
    - MaPhieuCoc: String
    - MaPDS: String
    - MaNV: String
    --
    + TaoPhieuThuTienHoaDon(maHoaDon: String, soTienThu: Decimal, phuongThuc: String, anhMinhChung: String, maNV: String, thoiDiem: DateTime): PhieuThu
    + LuuPhieu()
  }

  class DichVuHopDong {
    - MaHD: String
    - MaDV: String
    - DonGiaKyKet: Decimal
    - DichVu: DichVu
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }

  class DichVu {
    - MaDV: String
    - TenDV: String
    - DonGia: Decimal
    - DonViTinh: String
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - NgaySinh: DateTime
    - GioiTinh: String
    - QuocTich: String
    - LoaiGiayTo: String
    - SoGiayTo: String
    - DiaChiThuongTru: String
    - SDT: String
    - Email: String
  }

  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - Tang: String
    - GioiTinhChoPhep: String
    - TrangThai: String
    - MaLP: String
    - MaCN: String
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class HopDongDB {
    + LayDanhSachChoThanhToan(): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
    + UpdateTrangThai(maHD: String, trangThai: String): Boolean
  }

  class HoaDonDB {
    + ExistsHoaDonKyDau(maHD: String): Boolean
    + Insert(hoaDon: HoaDon): String
  }

  class ChiTietHoaDonDB {
    + InsertBatch(dsChiTiet: IReadOnlyList<ChiTietHoaDon>)
  }

  class PhieuThuDB {
    + InsertPhieuThu(phieuThu: PhieuThu)
  }

  class DichVuHopDongDB {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }
}

' Boundary dieu khien use case xu ly thanh toan hop dong.
MHXuLyThanhToanHopDong o-- XuLyThanhToanHopDong

' Trong BLL: UseCase dieu phoi cac entity.
XuLyThanhToanHopDong "1" -- "0..*" HopDong : doc / kiem tra
XuLyThanhToanHopDong "1" -- "0..*" HoaDon : tao hoa don ky dau
XuLyThanhToanHopDong "1" -- "0..*" ChiTietHoaDon : tao chi tiet
XuLyThanhToanHopDong "1" -- "0..*" PhieuThu : lap phieu thu
XuLyThanhToanHopDong "1" -- "0..*" DichVuHopDong : lay dich vu

' Quan he giua cac entity.
HopDong "0..*" -- "1" KhachHang : dai dien
HopDong "0..*" -- "1" Phong : phong thue
HopDong "1" -- "0..*" DichVuHopDong : dich vu ky ket
DichVuHopDong "0..*" -- "1" DichVu : tham chieu
HoaDon "0..*" -- "1" HopDong : thuoc
HoaDon "1" -- "1..*" ChiTietHoaDon : gom
PhieuThu "0..*" -- "1" HoaDon : thu tien

' Aggregation giua business va data access.
HopDong o-- HopDongDB
HoaDon o-- HoaDonDB
ChiTietHoaDon o-- ChiTietHoaDonDB
PhieuThu o-- PhieuThuDB
DichVuHopDong o-- DichVuHopDongDB

@enduml
