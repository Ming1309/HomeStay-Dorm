@startuml
title 3 Layers - UC Xử lý thanh toán hợp đồng - Bố cục gọn

skinparam dpi 220
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 65
skinparam linetype ortho
skinparam shadowing false

skinparam defaultFontSize 15
skinparam classFontSize 15
skinparam classAttributeFontSize 13
skinparam packageFontSize 17
skinparam titleFontSize 20

top to bottom direction

package "Presentation Layer\n(Tầng giao diện)" as PL {

    class "MH_XuLyThanhToanHopDong" as MH <<boundary>> {
        ' ===== Danh sách hợp đồng bên trái =====
        - lblTieuDeHangDoiThuTien: Label
        - lblSoHopDongCanXuLy: Label
        - txtTimKiemHopDong: TextBox
        - pnlDanhSachHopDong: Panel
        - cardHopDong: Panel
        - lblMaHopDongCard: Label
        - lblTenKhachCard: Label
        - lblPhongCard: Label
        - lblTongTienCard: Label
        - badgeChoThanhToanCard: Label

        ' ===== Thanh thông tin hợp đồng đang chọn =====
        - lblMaHopDongDangChon: Label
        - badgeChoThanhToan: Label
        - lblTenKhachDangChon: Label
        - lblPhongDangChon: Label
        - lblTongCanThanhToanTitle: Label
        - lblTongCanThanhToan: Label

        ' ===== Bảng chi tiết khoản thu =====
        - dgvKhoanThu: DataGridView
        - colKhoanThu: DataGridViewColumn
        - colSoLuongKy: DataGridViewColumn
        - colThanhTien: DataGridViewColumn

        ' ===== Khu vực tổng tiền =====
        - lblTongCongHoaDonTitle: Label
        - lblTongCongHoaDon: Label
        - lblDaThanhToanTruocTitle: Label
        - lblDaThanhToanTruoc: Label
        - lblTongConLaiCanThuTitle: Label
        - lblTongConLaiCanThu: Label

        ' ===== Nút xử lý =====
        - btnTienHanhThuTien: Button
        - errThongTin: ErrorProvider

        + loadHangDoiThuTien(): void
        + timKiemHopDong(): void
        + clickChonHopDong(): void
        + hienThiChiTietThanhToan(): void
        + hienThiBangKhoanThu(): void
        + hienThiTongTien(): void
        + clickTienHanhThuTien(): void
        + hienThiThongBao(): void
    }
}

package "Business Layer\n(Tầng nghiệp vụ)" as BL {

    class "HopDong" as HD <<entity>> {
        - maHD: String
        - ngayKy: Date
        - ngayBatDau: Date
        - ngayKetThuc: Date
        - kyThanhToan: String
        - giaThue: Decimal
        - dieuKhoan: String
        - trangThai: String
        - maNV: String
        - maPhieuCoc: String
        - maChinhSach: String
        - maQD: String
        - maQLDuyet: String

        + layHopDongChoThanhToan(): List<HopDong>
        + layThongTinHopDong(maHD: String): HopDong
        + kiemTraChoThanhToan(): boolean
        + capNhatTrangThaiChoBanGiao(): boolean
    }

    class "HoaDon" as HDon <<entity>> {
        - maHoaDon: String
        - ngayLap: Date
        - hanThanhToan: Date
        - loaiHoaDon: String
        - tongTien: Decimal
        - trangThai: String
        - ghiChu: String
        - maHD: String
        - maNV: String

        + tinhTongTienKyDau(dsChiTiet: List<ChiTietHoaDon>): Decimal
        + taoHoaDonKyDauDaThanhToan(): String
        + kiemTraChuaCoHoaDonKyDau(maHD: String): boolean
    }

    class "ChiTietHoaDon" as CTHDon <<entity>> {
        - maHoaDon: String
        - stt: int
        - loaiKhoanThu: String
        - maDV: String
        - maTS: String
        - maGiuong: String
        - soLuong: int
        - donViTinh: String
        - donGia: Decimal
        - thanhTien: Decimal

        + taoDongTienThueKyDau(): ChiTietHoaDon
        + taoDongDichVu(): List<ChiTietHoaDon>
        + tinhThanhTien(): Decimal
        + luuDanhSachChiTietHoaDon(): boolean
    }

    class "PhieuThu" as PT <<entity>> {
        - maPT: String
        - soTienThu: Decimal
        - thoiGian: DateTime
        - phuongThucThanhToan: String
        - anhMinhChung: String
        - maHoaDon: String
        - maPhieuCoc: String
        - maPDS: String
        - maNV: String

        + lapPhieuThuTienHoaDon(maHoaDon: String, soTienThu: Decimal): String
    }

    class "HopDong_DichVu" as HDDV <<entity>> {
        - maHD: String
        - maDV: String
        - donGiaKyKet: Decimal

        + layDichVuTheoHopDong(maHD: String): List<HopDong_DichVu>
    }

    class "DichVu" as DV <<entity>> {
        - maDV: String
        - tenDV: String
        - donGia: Decimal
        - donViTinh: String

        + layThongTinDichVu(dsMaDV: List<String>): List<DichVu>
    }

    class "KhachHang" as KH <<entity>> {
        - maKH: String
        - hoTen: String
        - ngaySinh: Date
        - gioiTinh: String
        - quocTich: String
        - loaiGiayTo: String
        - soGiayTo: String
        - diaChiThuongTru: String
        - sdt: String
        - email: String

        + layNguoiDaiDienTheoHopDong(maHD: String): KhachHang
    }

    class "Phong" as PH <<entity>> {
        - maPhong: String
        - soPhong: String
        - toaNha: String
        - tang: int
        - gioiTinhChoPhep: String
        - trangThai: String
        - maLP: String
        - maCN: String

        + layPhongTheoHopDong(maHD: String): Phong
    }

    class "ChiTietHopDong" as CTHD <<entity>> {
        - maHD: String
        - maGiuong: String
        - maKH: String
        - trangThaiThue: String
        - ngayTra: Date

        + demSoNguoiTheoHopDong(maHD: String): int
    }

    ' ===== Hàng 1: hóa đơn và khoản thu =====
    HD -[hidden]right- HDon
    HDon -[hidden]right- CTHDon

    ' ===== Hàng 2: phiếu thu và dịch vụ =====
    PT -[hidden]right- HDDV
    HDDV -[hidden]right- DV

    ' ===== Hàng 3: thông tin hiển thị phụ =====
    KH -[hidden]right- PH
    PH -[hidden]right- CTHD

    ' ===== Ép xuống hàng, không kéo ngang quá dài =====
    HD -[hidden]down- PT
    PT -[hidden]down- KH
}

package "Data Access Layer\n(Tầng truy xuất dữ liệu)" as DAL {

    class "HopDongDB" as HDDB <<database>> {
        + getHopDongChoThanhToan(): List<HopDong>
        + getByMaHD(maHD: String): HopDong
        + updateTrangThai(maHD: String, trangThai: String): boolean
    }

    class "HoaDonDB" as HDonDB <<database>> {
        + existsHoaDonKyDau(maHD: String): boolean
        + insert(hoaDon: HoaDon): String
        + updateTrangThai(maHoaDon: String, trangThai: String): boolean
    }

    class "ChiTietHoaDonDB" as CTHDonDB <<database>> {
        + insertBatch(dsChiTietHoaDon: List<ChiTietHoaDon>): boolean
    }

    class "PhieuThuDB" as PTDB <<database>> {
        + insert(phieuThu: PhieuThu): String
        + sumDaThanhToan(maHoaDon: String): Decimal
    }

    class "HopDong_DichVuDB" as HDDVDB <<database>> {
        + getByMaHD(maHD: String): List<HopDong_DichVu>
    }

    class "DichVuDB" as DVDB <<database>> {
        + getByIds(dsMaDV: List<String>): List<DichVu>
    }

    class "KhachHangDB" as KHDB <<database>> {
        + getDaiDienByMaHD(maHD: String): KhachHang
    }

    class "PhongDB" as PHDB <<database>> {
        + getPhongByMaHD(maHD: String): Phong
    }

    class "ChiTietHopDongDB" as CTHDDB <<database>> {
        + countKhachByMaHD(maHD: String): int
    }

    ' ===== Hàng 1 DB =====
    HDDB -[hidden]right- HDonDB
    HDonDB -[hidden]right- CTHDonDB

    ' ===== Hàng 2 DB =====
    PTDB -[hidden]right- HDDVDB
    HDDVDB -[hidden]right- DVDB

    ' ===== Hàng 3 DB =====
    KHDB -[hidden]right- PHDB
    PHDB -[hidden]right- CTHDDB

    ' ===== Ép xuống hàng =====
    HDDB -[hidden]down- PTDB
    PTDB -[hidden]down- KHDB
}

' =====================================================
' ÉP 3 TẦNG THEO CHIỀU DỌC
' =====================================================

MH -[hidden]down- HDon
HDon -[hidden]down- HDonDB

' =====================================================
' LIÊN KẾT PRESENTATION -> BUSINESS
' Hạn chế số đường nối để đỡ rối
' =====================================================

MH o-- HD : chọn hợp đồng chờ thanh toán
MH o-- HDon : tính / lập hóa đơn kỳ đầu
MH o-- CTHDon : hiển thị khoản thu
MH o-- PT : tiến hành thu tiền
MH o-- KH : hiển thị khách
MH o-- PH : hiển thị phòng
MH o-- HDDV : lấy dịch vụ hợp đồng

' =====================================================
' LIÊN KẾT BUSINESS -> DATA ACCESS
' =====================================================

HD o-- HDDB : đọc / cập nhật hợp đồng
HDon o-- HDonDB : thêm hóa đơn
CTHDon o-- CTHDonDB : lưu chi tiết hóa đơn
PT o-- PTDB : lập phiếu thu
HDDV o-- HDDVDB : đọc dịch vụ hợp đồng
DV o-- DVDB : đọc dịch vụ
KH o-- KHDB : đọc khách đại diện
PH o-- PHDB : đọc phòng
CTHD o-- CTHDDB : đếm người thuê

@enduml