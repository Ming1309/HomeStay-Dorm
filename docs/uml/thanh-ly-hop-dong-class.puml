+tienThuThem:Decimal
+trangThai:String

--

+layThongTinDoiSoat(maHD:String) : PhieuDoiSoat
+kiemTraCongNo(pds:PhieuDoiSoat) : Boolean

}

class ThanhVienHopDong #F4E3A2 {

+maHD:String
