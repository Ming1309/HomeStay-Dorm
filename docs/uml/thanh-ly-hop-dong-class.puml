+trangThaiThue:String

--

+layDanhSachGiuong(maHD:String) : List
+capNhatTrangThaiDaTra(maHD:String,ngayTra:DateTime)

}

class Giuong #F4E3A2 {

+maGiuong:String
+trangThai:String

--

+capNhatTrangThaiTrong(maGiuong:String)
+capNhatDanhSachTrong(dsMaGiuong:List)

}

}

'=====================
' LỚP DỮ LIỆU
'=====================

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {

class HopDongDB #BFDCF0 {

+getDanhSachChoThanhLy(tuKhoa:String) : List
+DocChiTiet(maHD:String) : HopDong
+updateTrangThaiThanhLy(maHD:String) : Boolean

}

class PhieuDoiSoatDB #BFDCF0 {

+getPhieuDoiSoatTheoMaHD(maHD:String) : PhieuDoiSoat

}

class ThanhVienHopDongDB #BFDCF0 {

+layDanhSachTheoHopDong(maHD:String) : List
+updateTrangThaiDaTra(maHD:String,ngayTra:DateTime) : Boolean

}

class GiuongDB #BFDCF0 {

+updateTrangThai(maGiuong:String,trangThai:String) : Boolean
+updateTrangThaiBatch(dsMaGiuong:List,trangThai:String)

}

}

MHThanhLyHopDong o-- HopDong
MHThanhLyHopDong o-- PhieuDoiSoat
MHThanhLyHopDong o-- ThanhVienHopDong
MHThanhLyHopDong o-- Giuong

HopDong o-- HopDongDB
PhieuDoiSoat o-- PhieuDoiSoatDB
ThanhVienHopDong o-- ThanhVienHopDongDB
Giuong o-- GiuongDB


GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
HopDong -[hidden]down- HopDongDB
Giuong -[hidden]down- HopDongDB
@enduml
