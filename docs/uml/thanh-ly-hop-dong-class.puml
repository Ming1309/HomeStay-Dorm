+lblNgayKetThuc

+lblTienCoc
+lblTongKhauTru
+lblTienHoan
+lblTienThuThem

+chkKyBienBanThanhLy
+chkThuHoiChiaKhoa

+btnThanhLy

--

+hienThiForm()
+loadDanhSachHopDong()
+hienThiThongTinHopDong(maHD:String)
+kiemTraDieuKienThanhLy(maHD:String)
