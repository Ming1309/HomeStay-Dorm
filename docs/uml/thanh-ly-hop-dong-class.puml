@startuml
title SO DO LOP - THANH LY HOP DONG

top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #AED6F1
skinparam classBorderColor #2980B9
skinparam classBackgroundColor #EBF5FB
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHThanhLyHopDong #BFE8BA {
    - txtTimKiem: TextBox
    - grvHopDongChoThanhLy: GridView
    - chkDaKyBienBan: CheckBox
    - chkDaThuHoiChiaKhoa: CheckBox
    - txtGhiChu: TextArea
    - btnThanhLy: Button
    --
    + taiDanhSach(tuKhoa: String)
    + chonHopDong(maHD: String)
    + xacNhanThanhLy()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class HopDong #F4E3A2 {
    - MaHD: String
    - TrangThai: String
    - MaPhieuCoc: String
    --
    + LayDanhSachChoThanhLy(tuKhoa: String): IReadOnlyList<HopDongChoThanhLy>
    + LayThongTinHopDong(maHD: String): HopDong
    + KiemTraDangHieuLuc()
    + ThanhLyHopDong(maHD: String, ngayThanhLy: DateTime, nguoiThucHien: String, ghiChu: String)
  }

  class PhieuDoiSoat #F4E3A2 {
    - MaPDS: String
    - TienHoan: Decimal
    - TienThuThem: Decimal
    - TrangThai: String
    --
    + LayThongTinDoiSoat(maHD: String): PhieuDoiSoat
    + KiemTraCongNo(pds: PhieuDoiSoat): Boolean
  }

  class PhieuCoc #F4E3A2 {
    - MaPhieuCoc: String
    - MaCN: String
    --
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
  }

  class ThanhVienHopDong #F4E3A2 {
    - MaHD: String
    - MaGiuong: String
    - TrangThaiThue: String
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
    + LayDanhSachGiuong(maHD: String): IReadOnlyList<ThanhVienHopDong>
    + CapNhatTrangThaiDaTra(maHD: String, ngayTra: DateTime)
  }

  class DichVuHopDong #F4E3A2 {
    - MaHD: String
    - MaDV: String
    --
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }

  class Giuong #F4E3A2 {
    - MaGiuong: String
    - TrangThai: String
    --
    + CapNhatDanhSachTrong(dsMaGiuong: IReadOnlyList<String>)
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class HopDongDB #BFDCF0 {
    + LayDanhSachChoThanhLy(tuKhoa: String): IReadOnlyList<HopDongChoThanhLy>
    + DocChiTiet(maHD: String): HopDong
    + UpdateTrangThaiThanhLy(maHD: String): Boolean
  }

  class PhieuDoiSoatDB #BFDCF0 {
    + GetPhieuDoiSoatTheoMaHD(maHD: String): PhieuDoiSoat
  }

  class PhieuCocDB #BFDCF0 {
    + DocChiTietHeThong(maPhieuCoc: String, khoaCapNhat: Boolean): PhieuCoc
  }

  class ThanhVienHopDongDB #BFDCF0 {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<ThanhVienHopDong>
    + UpdateTrangThaiDaTra(maHD: String, ngayTra: DateTime): Boolean
  }

  class DichVuHopDongDB #BFDCF0 {
    + LayDanhSachTheoHopDong(maHD: String): IReadOnlyList<DichVuHopDong>
  }

  class GiuongDB #BFDCF0 {
    + UpdateTrangThaiBatch(dsMaGiuong: IReadOnlyList<String>, trangThai: String)
  }
}

MHThanhLyHopDong o-- HopDong
MHThanhLyHopDong o-- PhieuDoiSoat
MHThanhLyHopDong o-- PhieuCoc
MHThanhLyHopDong o-- ThanhVienHopDong
MHThanhLyHopDong o-- Giuong
HopDong -- ThanhVienHopDong
HopDong -- DichVuHopDong

HopDong o-- HopDongDB
PhieuDoiSoat o-- PhieuDoiSoatDB
PhieuCoc o-- PhieuCocDB
ThanhVienHopDong o-- ThanhVienHopDongDB
DichVuHopDong o-- DichVuHopDongDB
Giuong o-- GiuongDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
HopDong -[hidden]down- HopDongDB
PhieuDoiSoat -[hidden]down- PhieuDoiSoatDB
PhieuCoc -[hidden]down- PhieuCocDB
ThanhVienHopDong -[hidden]down- ThanhVienHopDongDB
DichVuHopDong -[hidden]down- DichVuHopDongDB
Giuong -[hidden]down- GiuongDB
@enduml
