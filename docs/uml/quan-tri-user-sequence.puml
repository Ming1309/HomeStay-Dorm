@startuml
title Quản trị tài khoản nhân viên

actor "Quan tri vien" as QTV

box "GUI" #D5F5D3
boundary MHQuanLyNguoiDung
end box

box "BUS" #FCF3CF
control QuanLyNguoiDung
control TaiKhoan
control NhanVien
control ChiNhanh
end box

box "DB" #D6EAF8
entity TaiKhoanDB
entity NhanVienDB
entity ChiNhanhDB
end box
skinparam responseMessageBelowArrow true


QTV -> MHQuanLyNguoiDung : Chon chuc nang "Quan ly nguoi dung"
activate MHQuanLyNguoiDung
MHQuanLyNguoiDung -> MHQuanLyNguoiDung : HienThi()
MHQuanLyNguoiDung -> QuanLyNguoiDung: LayDanhSach()
activate QuanLyNguoiDung
QuanLyNguoiDung -> TaiKhoan: LayDanhSach()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: LayDanhSach()
activate TaiKhoanDB
MHQuanLyNguoiDung -> QuanLyNguoiDung: LayDanhSachChiNhanh()
deactivate TaiKhoanDB
deactivate TaiKhoan
QuanLyNguoiDung -> ChiNhanh: LayDanhSach()
activate ChiNhanh
ChiNhanh -> ChiNhanhDB: LayDanhSach()
activate ChiNhanhDB
QTV -> MHQuanLyNguoiDung : Nhap thong tin tai khoan va nhan vien
QTV -> MHQuanLyNguoiDung : Nhan "Them"
MHQuanLyNguoiDung -> MHQuanLyNguoiDung : btnThem_Click()
MHQuanLyNguoiDung -> QuanLyNguoiDung: Tao()
deactivate ChiNhanhDB
deactivate ChiNhanh
QuanLyNguoiDung -> NhanVien: Them()
activate NhanVien
NhanVien -> NhanVienDB: Them()
activate NhanVienDB
deactivate NhanVienDB
deactivate NhanVien
QuanLyNguoiDung -> TaiKhoan: Them()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: Them()
activate TaiKhoanDB
QTV -> MHQuanLyNguoiDung : Chon tai khoan va trang thai moi
QTV -> MHQuanLyNguoiDung : Xac nhan doi trang thai
MHQuanLyNguoiDung -> MHQuanLyNguoiDung : btnKhoa_Click()
MHQuanLyNguoiDung -> QuanLyNguoiDung: DoiTrangThai()
deactivate TaiKhoanDB
deactivate TaiKhoan
QuanLyNguoiDung -> TaiKhoan: Doc()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: Doc()
activate TaiKhoanDB
deactivate TaiKhoanDB
deactivate TaiKhoan
QuanLyNguoiDung -> TaiKhoan: Khoa() / MoKhoa() / VoHieuHoa()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: CapNhatTrangThai()
activate TaiKhoanDB
QTV -> MHQuanLyNguoiDung : Chon tai khoan va nhap mat khau tam
QTV -> MHQuanLyNguoiDung : Xac nhan dat lai mat khau
MHQuanLyNguoiDung -> MHQuanLyNguoiDung : btnDatLaiMatKhau_Click()
MHQuanLyNguoiDung -> QuanLyNguoiDung: DatLaiMatKhau()
deactivate TaiKhoanDB
deactivate TaiKhoan
QuanLyNguoiDung -> TaiKhoan: Doc()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: Doc()
activate TaiKhoanDB
deactivate TaiKhoanDB
deactivate TaiKhoan
QuanLyNguoiDung -> TaiKhoan: DoiMatKhau()
activate TaiKhoan
TaiKhoan -> TaiKhoanDB: DatMatKhau()
activate TaiKhoanDB
deactivate TaiKhoanDB
deactivate TaiKhoan
deactivate QuanLyNguoiDung
deactivate MHQuanLyNguoiDung
@enduml
