@startuml
title SO DO LOP 3 TANG - LAP BIEN BAN THU HOI TAI SAN
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BorderColor #7F8C8D
}

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHLapBienBanThuHoiTaiSan #BFE8BA {
    - txtTimKiemHopDong: TextBox
    - grvHopDongTraPhong: GridView
    - lblMaHopDong: Label
    - lblHoTenKhachHang: Label
    - lblPhong: Label
    - lblNgayTraPhong: Label
    - grvTaiSanThuHoi: GridView
    - txtSoLuongThuHoi: TextBox
    - lstTinhTrangTaiSan: ListBox
    - txtGhiChu: TextArea
    - chkDaThuHoiChiaKhoa: CheckBox
    - dlgXacNhanLapBienBan: AlertDialog
    - btnLuuBienBan: Button
    --
    + HienThi()
    + chonHopDong(maHD: String)
    + capNhatTaiSan(maTS: String, soLuong: Integer, tinhTrang: String)
    + lapBienBan()
  }
}
package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class LapBienBanThuHoiTaiSan #F4E3A2 {
    + LayDanhSachHopDongTraPhongHomNay(tuKhoa: String): IReadOnlyList<HopDong>
    + LayChiTietHopDongThuHoi(maHD: String): ChiTietThuHoi
    + LapBienBan(maHD: String, maNV: String, taiSan: IReadOnlyList<TaiSanThuHoiInput>): BienBanGiaoNhan
  }
  class HopDong #F4E3A2 {
    + LayDanhSachCoLichTraTrongNgay(tuKhoa: String): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
    + CoLichTraPhongTrongNgay(maHD: String): Boolean
    + KiemTraDangHieuLuc()
  }
  class PhongTaiSan #F4E3A2 {
    + LayTaiSanTheoPhong(maPhong: String): IReadOnlyList<PhongTaiSan>
  }
  class BienBanGiaoNhan #F4E3A2 {
    + TonTaiThuHoiTheoHD(maHD: String): Boolean
    + KhoiTaoThuHoi(maHD: String, maNV: String, ngayBanGiao: DateTime, chiTiet: IEnumerable<ChiTietGiaoNhan>): BienBanGiaoNhan
    + KiemTraDuLieuTaiSan()
    + LuuBienBan()
  }
  class ChiTietGiaoNhan #F4E3A2 {
    + KiemTraHopLe()
    + ThemNhieu(chiTiet: IEnumerable<ChiTietGiaoNhan>)
  }
}
package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class HopDongDB #BFDCF0 {
    + LayDanhSachCoLichTraTrongNgay(tuKhoa: String): IReadOnlyList<HopDong>
    + DocChiTiet(maHD: String): HopDong
    + CoLichTraPhongTrongNgay(maHD: String): Boolean
  }
  class PhongTaiSanDB #BFDCF0 {
    + LayTaiSanTheoPhong(maPhong: String): IReadOnlyList<PhongTaiSan>
  }
  class BienBanGiaoNhanDB #BFDCF0 {
    + TonTaiThuHoiTheoHD(maHD: String): Boolean
    + Them(bienBan: BienBanGiaoNhan)
  }
  class ChiTietGiaoNhanDB #BFDCF0 {
    + ThemNhieu(chiTiet: IEnumerable<ChiTietGiaoNhan>)
  }
}
GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
MHLapBienBanThuHoiTaiSan o-down- LapBienBanThuHoiTaiSan
LapBienBanThuHoiTaiSan o-- HopDong
LapBienBanThuHoiTaiSan o-- PhongTaiSan
LapBienBanThuHoiTaiSan o-- BienBanGiaoNhan
LapBienBanThuHoiTaiSan o-- ChiTietGiaoNhan
HopDong o-down- HopDongDB
PhongTaiSan o-down- PhongTaiSanDB
BienBanGiaoNhan o-down- BienBanGiaoNhanDB
ChiTietGiaoNhan o-down- ChiTietGiaoNhanDB
LapBienBanThuHoiTaiSan -[hidden]down- HopDongDB
ChiTietGiaoNhan -[hidden]down- HopDongDB
@enduml
