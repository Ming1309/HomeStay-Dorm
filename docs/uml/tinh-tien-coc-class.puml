@startuml
title SO DO LOP 3 TANG - TINH TIEN COC

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFACD
  BorderColor #9B7B7B
}

package "TANG GIAO DIEN" #EAF2F8 {
  class MHTinhTienCoc {
    - txtTimKiemPhieu: TextBox
    - grvPhieuCocKhoiTao: GridView
    - lblMaPhieuCoc: Label
    - lblHoTenKhachHang: Label
    - lblPhong: Label
    - lblHinhThucThue: Label
    - lblGiaThue: Label
    - lblSoGiuongTinhTien: Label
    - lblCongThucTinhTien: Label
    - lblTongTien: Label
    - grvGiuongDaChon: GridView
    - btnXacNhan: Button
    --
    + taiDanhSach(text: String)
    + chonPhieuCoc(maPhieuCoc: String)
    + xacNhan()
  }
}

package "TANG NGHIEP VU" #FCF3CF {
  class TinhTienCoc {
    + LayDanhSachKhoiTao(text: String): IReadOnlyList<PhieuCoc>
    + LayChiTietVaTinhTien(maPhieuCoc: String): PhieuCoc
    + XacNhanTinhTien(maPhieuCoc: String): PhieuCoc
  }

  class PhieuCoc {
    - MaPhieuCoc: String
    - HinhThucThue: String
    - SoGiuongThue: Integer
    - TongTien: Decimal
    - HanThanhToan: DateTime
    - TrangThai: String
    - KhachHang: KhachHang
    - Phong: Phong
    - Giuongs: List<Giuong>
    + LayDanhSachKhoiTao(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + TinhTienDuKien(): Integer
    + XacNhanTinhTien(thoiDiemXacNhan: DateTime)
    + CapNhatTinhTien()
  }

  class KhachHang {
    - MaKH: String
    - HoTen: String
    - SDT: String
    - Email: String
  }
  class Phong {
    - MaPhong: String
    - SoPhong: String
    - ToaNha: String
    - LoaiPhong: LoaiPhong
    + TinhTienCoc(soGiuong: Integer): Decimal
  }
  class LoaiPhong {
    - SucChua: Integer
    - GiaThue: Decimal
  }
  class Giuong {
    - MaGiuong: String
    - SoGiuong: String
    - TrangThai: String
  }
}

package "TANG TRUY CAP DU LIEU" #FDEDEC {
  class PhieuCocDB {
    + LayDanhSachKhoiTao(text: String): IReadOnlyList<PhieuCoc>
    + DocChiTiet(maPhieuCoc: String): PhieuCoc
    + CapNhatTinhTien(phieu: PhieuCoc)
  }
}

MHTinhTienCoc o-- TinhTienCoc
TinhTienCoc o-- PhieuCoc
PhieuCoc o-- PhieuCocDB
PhieuCoc "0..*" -- "1" KhachHang : dai dien
PhieuCoc "0..*" -- "1" Phong : dat
PhieuCoc "0..*" -- "1..*" Giuong : chi tiet
Phong "0..*" -- "1" LoaiPhong : thuoc

@enduml
