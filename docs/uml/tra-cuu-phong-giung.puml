@startuml
title Sequence - UC Tra cứu phòng/giường

skinparam dpi 180
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 20
skinparam BoxPadding 10

actor "Nhân viên Sale" as NV

box "GUI" #D5F5D3
participant MHTraCuuPhongGiuong
end box

box "BUS" #FCF3CF
participant ChiNhanh
participant LoaiPhong
participant Phong
participant Giuong
participant "Phong_TaiSan" as PhongTaiSan
end box

box "DB" #D6EAF8
participant ChiNhanhDB
participant LoaiPhongDB
participant PhongDB
participant GiuongDB
participant "Phong_TaiSanDB" as PhongTaiSanDB
end box

== Khởi tạo màn hình ==

NV -> MHTraCuuPhongGiuong : 1.0 Chức năng tra cứu phòng/giường

MHTraCuuPhongGiuong -> ChiNhanh : 1.1 layDanhSach()
activate ChiNhanh

ChiNhanh -> ChiNhanhDB : 1.2 layDanhSach()
activate ChiNhanhDB
ChiNhanhDB --> ChiNhanh : dsChiNhanh
deactivate ChiNhanhDB
ChiNhanh --> MHTraCuuPhongGiuong : dsChiNhanh
deactivate ChiNhanh

MHTraCuuPhongGiuong -> LoaiPhong : 1.3 layDanhSach()
activate LoaiPhong

LoaiPhong -> LoaiPhongDB : 1.4 layDanhSach()
activate LoaiPhongDB
LoaiPhongDB --> LoaiPhong : dsLoaiPhong
deactivate LoaiPhongDB
LoaiPhong --> MHTraCuuPhongGiuong : dsLoaiPhong
deactivate LoaiPhong

== Lọc phòng ==

alt Không nhập tiêu chí

NV -> MHTraCuuPhongGiuong : Chọn bộ lọc

MHTraCuuPhongGiuong -> Phong : locPhongTheoTieuChi()
activate Phong

Phong -> PhongDB : layPhongTheoBoLoc()
activate PhongDB
PhongDB --> Phong : dsPhong
deactivate PhongDB

loop Với mỗi phòng

Phong -> Giuong : layDanhSachGiuong(maPhong)
activate Giuong

Giuong -> GiuongDB : layGiuongTheoPhong(maPhong)
activate GiuongDB
GiuongDB --> Giuong : dsGiuong
deactivate GiuongDB

Giuong --> Phong : dsGiuong
deactivate Giuong

end

Phong --> MHTraCuuPhongGiuong : dsPhong
deactivate Phong

else Có nhập tiêu chí

NV -> MHTraCuuPhongGiuong : Chọn bộ lọc

MHTraCuuPhongGiuong -> Phong : locPhongTheoTieuChi(toaNha,tang,maLP,maCN,trangThai,giaMin,giaMax)
activate Phong

Phong -> PhongDB : layPhongTheoBoLoc(toaNha,tang,maLP,maCN,trangThai,giaMin,giaMax)
activate PhongDB
PhongDB --> Phong : dsPhong
deactivate PhongDB

loop Với mỗi phòng

Phong -> Giuong : layDanhSachGiuong(maPhong)
activate Giuong

Giuong -> GiuongDB : layGiuongTheoPhong(maPhong)
activate GiuongDB
GiuongDB --> Giuong : dsGiuong
deactivate GiuongDB

Giuong --> Phong : dsGiuong
deactivate Giuong

end

Phong --> MHTraCuuPhongGiuong : dsPhong
deactivate Phong

end

MHTraCuuPhongGiuong --> NV : 2.0 hienThiDanhSachPhong(dsPhong)

== Xem tài sản ==

opt Bấm Xem tài sản

NV -> MHTraCuuPhongGiuong : btnXemTaiSan_Click()

MHTraCuuPhongGiuong -> Phong : layTaiSan(maPhong)
activate Phong

Phong -> PhongTaiSan : layTaiSanTheoPhong(maPhong)
activate PhongTaiSan

PhongTaiSan -> PhongTaiSanDB : layTaiSanTheoPhong(maPhong)
activate PhongTaiSanDB
PhongTaiSanDB --> PhongTaiSan : dsTaiSan
deactivate PhongTaiSanDB

PhongTaiSan --> Phong : dsTaiSan
deactivate PhongTaiSan

Phong --> MHTraCuuPhongGiuong : dsTaiSan
deactivate Phong

MHTraCuuPhongGiuong --> NV : hienThiDanhSachTaiSan(dsTaiSan)

end
@enduml