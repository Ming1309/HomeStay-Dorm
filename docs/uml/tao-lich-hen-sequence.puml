@startuml
title SO DO TUAN TU - TAO LICH HEN
hide footbox
autonumber
skinparam shadowing false

actor "Nhan vien Sale" as Sale
boundary ": MHTaoLichHen" as MH
control ": TaoLichHen" as TLH
control ": NhanVien" as NV
entity ": NhanVienDB" as NVDB
control ": LichHen" as LH
entity ": LichHenDB" as LHDB

Sale -> MH : HienThi()
Sale -> MH : TimChungTu(loai, tuKhoa)
MH -> TLH : TaiDanhSachChungTu(loai, tuKhoa, maNV)
TLH -> NV : DocPhamVi(maNV)
NV -> NVDB : DocChiTiet(maNV)
note right of TLH
  Danh sach chung tu duoc loc theo MaCN
  cua nhan vien doc lai tu database.
end note

Sale -> MH : LuuLichHen()
MH -> TLH : LuuLichHen(loai, maChungTu, ngayHen, gioHen, maNV)
TLH -> NV : DocPhamVi(maNV)
NV -> NVDB : DocChiTiet(maNV)
TLH -> LH : TaoMoi(loai, maChungTu, maCN, ngayHen, gioHen, maNV, thoiDiem)
TLH -> LH : KiemTraThoiGianHopLe(thoiDiem)
TLH -> LH : KiemTraHopLe()
TLH -> LH : KiemTraTrungLich()
LH -> LHDB : KiemTraLichTrungCaNhanVien(maNV, ngayHen, gioHen)
alt Hop le va khong trung lich
  TLH -> LH : Them()
  LH -> LHDB : Them(lichHen)
else Sai chi nhanh, trang thai hoac trung lich
  TLH -> MH : HienThiLoi()
end
@enduml
