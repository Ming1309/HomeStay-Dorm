@startuml
title SO DO LOP - LAP HOA DON BOI THUONG

top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #AED6F1
skinparam classBorderColor #2980B9
skinparam classBackgroundColor #EBF5FB
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho

package "TANG GIAO DIEN" as GUI_LAYER #EDF9EC {
  class MHLapHoaDonBoiThuong #BFE8BA {
    - txtTimKiem: TextBox
    - grvBienBanChuaXuLy: GridView
    - grvTaiSanHuHong: GridView
    - txtGhiChu: TextArea
    - btnLapHoaDon: Button
    --
    + taiDanhSach(tuKhoa: String)
    + chonBienBan(maBienBan: String)
    + lapHoaDon()
  }
}

package "TANG NGHIEP VU" as BUS_LAYER #FFF9E6 {
  class BienBanGiaoNhan #F4E3A2 {
    - MaBienBan: String
    - LoaiBienBan: String
    - MaHD: String
    --
    + LayDSBienBanThuHoiChuaXuLy(tuKhoa: String): IReadOnlyList<BienBanGiaoNhan>
    + LayChiTietBienBan(maBienBan: String): BienBanGiaoNhan
    + DaCoHoaDonBoiThuongTheoHD(maHD: String): Boolean
  }

  class ChiTietGiaoNhan #F4E3A2 {
    - MaBienBan: String
    - MaTS: String
    - TinhTrang: String
    - SoLuong: Integer
    --
    + LayDSTaiSanHuHongTheoBienBan(maBienBan: String): IReadOnlyList<ChiTietGiaoNhan>
  }

  class TaiSan #F4E3A2 {
    - MaTS: String
    - TenTaiSan: String
    - GiaTri: Decimal
    --
    + LayThongTinTaiSan(maTS: String): TaiSan
  }

  class NhanVien #F4E3A2 {
    - MaNV: String
    - HoTen: String
    --
    + LayThongTinNhanVien(maNV: String): NhanVien
  }

  class HoaDon #F4E3A2 {
    - MaHoaDon: String
    - TongTien: Decimal
    - TrangThai: String
    - MaHD: String
    --
    + KiemTraTinhHopLe(dsSoTien: IReadOnlyList<Decimal>): Boolean
    + TaoHoaDonBoiThuong(maBienBan: String, tongTien: Decimal, maNV: String, ngayLap: DateTime, ghiChuThem: String): HoaDon
  }

  class ChiTietHoaDon #F4E3A2 {
    - MaHoaDon: String
    - MaTS: String
    - SoLuong: Decimal
    - DonGia: Decimal
    --
    + TaoChiTietHoaDon(maHoaDon: String, dsChiTiet: IReadOnlyList<ChiTietHoaDon>): Boolean
  }
}

package "TANG TRUY CAP DU LIEU" as DAL_LAYER #EDF6FC {
  class BienBanGiaoNhanDB #BFDCF0 {
    + GetDSBienBanThuHoiChuaXuLy(tuKhoa: String): IReadOnlyList<BienBanGiaoNhan>
    + GetBienBanTheoMaBienBan(maBienBan: String): BienBanGiaoNhan
    + DaCoHoaDonBoiThuongTheoHD(maHD: String): Boolean
  }

  class ChiTietGiaoNhanDB #BFDCF0 {
    + GetDSTaiSanHuHongTheoBienBan(maBienBan: String): IReadOnlyList<ChiTietGiaoNhan>
  }

  class TaiSanDB #BFDCF0 {
    + GetTaiSanTheoMaTS(maTS: String): TaiSan
  }

  class NhanVienDB #BFDCF0 {
    + GetNhanVienTheoMaNV(maNV: String): NhanVien
  }

  class HoaDonDB #BFDCF0 {
    + InsertHoaDon(hoaDon: HoaDon): String
  }

  class ChiTietHoaDonDB #BFDCF0 {
    + InsertChiTietHoaDon(chiTiet: ChiTietHoaDon)
  }
}

MHLapHoaDonBoiThuong o-- BienBanGiaoNhan
MHLapHoaDonBoiThuong o-- ChiTietGiaoNhan
MHLapHoaDonBoiThuong o-- TaiSan
MHLapHoaDonBoiThuong o-- NhanVien
MHLapHoaDonBoiThuong o-- HoaDon
MHLapHoaDonBoiThuong o-- ChiTietHoaDon

BienBanGiaoNhan o-- BienBanGiaoNhanDB
ChiTietGiaoNhan o-- ChiTietGiaoNhanDB
TaiSan o-- TaiSanDB
NhanVien o-- NhanVienDB
HoaDon o-- HoaDonDB
ChiTietHoaDon o-- ChiTietHoaDonDB

GUI_LAYER -[hidden]down- BUS_LAYER
BUS_LAYER -[hidden]down- DAL_LAYER
BienBanGiaoNhan -[hidden]down- BienBanGiaoNhanDB
ChiTietGiaoNhan -[hidden]down- ChiTietGiaoNhanDB
TaiSan -[hidden]down- TaiSanDB
NhanVien -[hidden]down- NhanVienDB
HoaDon -[hidden]down- HoaDonDB
ChiTietHoaDon -[hidden]down- ChiTietHoaDonDB
@enduml
