@startuml LapHoaDonBoiThuong_3Lop

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #AED6F1
skinparam classBorderColor #2980B9
skinparam classBackgroundColor #EBF5FB
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho

' =====================
' LỚP GIAO DIỆN
' =====================

package "Lớp giao diện" #EBF5FB {

    class MHLapHoaDonBoiThuong {
        ' --- Danh sách biên bản ---
        +dgvDSBienBan : DataGridView
        +txtTimKiem : TextBox
        ' --- Thông tin biên bản ---
        +lblMaBienBan : Label
        +lblTrangThai : Label
        +lblKhachHang : Label
        +lblPhong : Label
        +lblHopDong : Label
        +lblNgayLap : Label
        +lblNguoiLap : Label
        ' --- Danh sách tài sản hư hỏng ---
        +dgvDSTaiSan : DataGridView
        +txtSoTienPhat : TextBox
        ' --- Nút hành động ---
        +btnLapHoaDonBoiThuong : Button
        ' --- Dialog thành công ---
        +dlgThanhCong : Dialog
        +lblMaHoaDon : Label
        +lblBienBanThuHoi : Label
        +lblKhachHangHD : Label
        +lblTongBoiThuong : Label
        +lblTrangThaiHD : Label
        +btnHoanTat : Button
        ' --- Phương thức ---
        +hienThiForm()
        +loadDSBienBanChuaXuLy()
        +hienThiChiTietBienBan()
        +hienThiDSTaiSanHuHong()
        +kiemTraTinhHopLe() : Boolean
        +btnLapHoaDonBoiThuong_Click()
        +hienThiDialogThanhCong()
        +btnHoanTat_Click()
    }
}

' =====================
' LỚP NGHIỆP VỤ
' =====================

package "Lớp nghiệp vụ" #FEF9E7 {

    class BienBanGiaoNhan {
        +maBienBan : String
        +ngayBanGiao : DateTime
        +loaiBienBan : String
        +maHD : String
        +maNV : String
        ' ---
        +layDSBienBanThuHoiChuaXuLy() : List<BienBanGiaoNhan>
        +layChiTietBienBan(maBienBan : String) : BienBanGiaoNhan
    }

    class ChiTietGiaoNhan {
        +maBienBan : String
        +maTS : String
        +tinhTrang : String
        +soLuong : Integer
        +ghiChu : String
        +minhChung : String
        ' ---
        +layDSTaiSanHuHongTheoBienBan(maBienBan : String) : List<ChiTietGiaoNhan>
    }

    class TaiSan {
        +maTS : String
        +tenTaiSan : String
        +giaTri : Decimal
        ' ---
        +layThongTinTaiSan(maTS : String) : TaiSan
    }

    class HoaDon {
        +maHoaDon : String
        +ngayLap : DateTime
        +hanThanhToan : DateTime
        +loaiHoaDon : String
        +tongTien : Decimal
        +trangThai : String
        +ghiChu : String
        +maHD : String
        +maNV : String
        ' ---
        +taoHoaDonBoiThuong(maBienBan : String, tongTien : Decimal, maNV : String) : HoaDon
        +kiemTraTinhHopLe(dsSoTien : List) : Boolean
    }

    class ChiTietHoaDon {
        +maHoaDon : String
        +stt : Integer
        +loaiKhoanThu : String
        +maTS : String
        +soLuong : Integer
        +donViTinh : String
        +donGia : Decimal
        +thanhTien : Decimal
        ' ---
        +taoChiTietHoaDon(maHoaDon : String, dsChiTiet : List) : Boolean
    }

    class NhanVien {
        +maNV : String
        +hoTen : String
        +sdt : String
        +vaiTro : String
        +maCN : String
        ' ---
        +layThongTinNhanVien(maNV : String) : NhanVien
    }
}

' =====================
' LỚP TRUY XUẤT DỮ LIỆU
' =====================

package "Lớp truy xuất dữ liệu" #FDF2F8 {

    class BienBanGiaoNhanDB {
        +getDSBienBanThuHoiChuaXuLy() : List<BienBanGiaoNhan>
        +getBienBanTheoMaBienBan(maBienBan : String) : BienBanGiaoNhan
    }

    class ChiTietGiaoNhanDB {
        +getDSTaiSanHuHongTheoBienBan(maBienBan : String) : List<ChiTietGiaoNhan>
    }

    class TaiSanDB {
        +getTaiSanTheoMaTS(maTS : String) : TaiSan
    }

    class HoaDonDB {
        +insertHoaDon(hoaDon : HoaDon) : String
    }

    class ChiTietHoaDonDB {
        +insertChiTietHoaDon(chiTiet : ChiTietHoaDon) : Boolean
    }

    class NhanVienDB {
        +getNhanVienTheoMaNV(maNV : String) : NhanVien
    }
}

' =====================
' QUAN HỆ
' =====================

MHLapHoaDonBoiThuong o-- BienBanGiaoNhan
MHLapHoaDonBoiThuong o-- ChiTietGiaoNhan
MHLapHoaDonBoiThuong o-- TaiSan
MHLapHoaDonBoiThuong o-- HoaDon
MHLapHoaDonBoiThuong o-- ChiTietHoaDon
MHLapHoaDonBoiThuong o-- NhanVien

BienBanGiaoNhan  o-- BienBanGiaoNhanDB
ChiTietGiaoNhan  o-- ChiTietGiaoNhanDB
TaiSan           o-- TaiSanDB
HoaDon           o-- HoaDonDB
ChiTietHoaDon    o-- ChiTietHoaDonDB
NhanVien         o-- NhanVienDB

@enduml