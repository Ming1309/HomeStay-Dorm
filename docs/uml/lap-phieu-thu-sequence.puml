@startuml LapPhieuThu_Sequence

skinparam sequenceArrowThickness 1.2
skinparam shadowing false
skinparam sequenceMessageAlign left

title Lập phiếu thu - Thanh toán trả phòng

actor "Kế Toán" as KT

box "GUI" #D5F5D3
    boundary "MHLapPhieuThu" as MH
end box

box "BUS" #FCF3CF
    control "PhieuDoiSoat" as PDS
    control "HoaDon" as HD
    control "PhieuThu" as PT
    control "NhanVien" as NV
end box

box "DB" #D6EAF8
    entity "PhieuDoiSoatDB" as PDSDB
    entity "HoaDonDB" as HDDB
    entity "PhieuThuDB" as PTDB
    entity "NhanVienDB" as NVDB
end box

' =====================
' KHỞI TẠO MÀN HÌNH
' =====================

KT -> MH : 1.0 Mở màn hình\nLập phiếu thu (maPDS)
activate MH

MH -> PDS : 2.0 layChiTietPhieuDoiSoat(maPDS)
activate PDS
PDS -> PDSDB : 2.1 getPhieuDoiSoatTheoMaPDS(maPDS)
activate PDSDB
deactivate PDSDB
deactivate PDS

MH -> HD : 2.2 layDSHoaDonCanThuTheoPDS(maPDS)
activate HD
HD -> HDDB : 2.3 getDSHoaDonCanThuTheoPDS(maPDS)
activate HDDB
deactivate HDDB
deactivate HD

MH -> HD : 2.4 tinhTongCanThu(maPDS)
activate HD
HD -> HDDB : 2.5 tinhTongCanThu(maPDS)
activate HDDB
deactivate HDDB
deactivate HD

' =====================
' NHẬP LIỆU
' =====================

MH -> MH : 3.0 Hiển thị tienThuThem do máy chủ tính

KT -> MH : 4.0 Chọn phuongThucThanhToan\n(Tiền mặt / Chuyển khoản)

KT -> MH : 4.1 Tải lên minh chứng\nthanh toán (nếu có)

' =====================
' XÁC NHẬN THU TIỀN
' =====================

KT -> MH : Nhan "Xac Nhan Thu Tien"
MH -> MH : 5.0 btnXacNhanThuTien_Click()

MH -> NV : 5.1 layThongTinNhanVien(maNV)
activate NV
NV -> NVDB : 5.2 getNhanVienTheoMaNV(maNV)
activate NVDB
deactivate NVDB
deactivate NV

MH -> PT : 5.3 taoPhieuThu(maPDS, tienThuThem,\nphuongThuc, anhMinhChung, maNV)
activate PT
PT -> PTDB : 5.4 insertPhieuThu(phieuThu)
activate PTDB
deactivate PTDB
deactivate PT

PT -> PT : 5.5 kiemTraTrungTheoMaPDS()
MH -> PDS : 5.6 chuyenSangDaTatToan(maPDS)
activate PDS
PDS -> PDSDB : 5.7 updateTrangThai(maPDS, "DaChot", "DaTatToan")
activate PDSDB
deactivate PDSDB
deactivate PDS

deactivate MH

KT -> MH : Nhan "Quay Lai"
MH -> MH : 6.0 btnQuayLai_Click()

@enduml
