@startuml TraCuuPhieuDangKy_3Lop

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5

skinparam class {
    HeaderBackgroundColor #AED6F1
    BorderColor #2980B9
    BackgroundColor #FFFFFF
    FontColor #000000
}

' =====================
' LỚP GIAO DIỆN
' =====================

package "Lớp giao diện" #D6EAF8 {

    class MHTraCuuPhieuDangKy {
        ' --- Tìm kiếm ---
        +txtTimKiem : TextBox
        +btnTimKiem : Button
        +lblKetQuaTimKiem : Label
        ' --- Danh sách kết quả ---
        +grvDSPhieuDangKy : DataGridView
        ' --- Thông tin chi tiết phiếu ---
        +lblMaPDK : Label
        +lblNgayNop : Label
        +lblTrangThai : Label
        ' --- Thông tin khách hàng ---
        +lblTenKH : Label
        +lblSDT : Label
        +lblEmail : Label
        +lblLoaiGiayTo : Label
        +lblSoGiayTo : Label
        ' --- Yêu cầu lưu trú ---
        +lblKhuVuc : Label
        +lblMucGia : Label
        +lblThoiGianDuKienVao : Label
        +lblThoiHanThue : Label
        ' --- Chi tiết thêm ---
        +lblLoaiDichVu : Label
        +lblSoLuongNguoi : Label
        +lblNgayNopCT : Label
        ' --- Ghi chú ---
        +lblYeuCauKhac : Label
        ' --- Phương thức ---
        +hienThiForm()
        +timKiem(tuKhoa : String)
        +hienThiDSKetQua()
        +hienThiChiTietPhieuDangKy()
        +btnTimKiem_Click()
        +grvDSPhieuDangKy_Click()
    }
}

' =====================
' LỚP NGHIỆP VỤ
' =====================

package "Lớp nghiệp vụ" #FEF9E7 {

    class PhieuDangKy {
        +maPDK : String
        +khuVuc : String
        +soLuongNguoi : Integer
        +loaiDichVu : String
        +mucGia : String
        +thoiGianDuKienVao : DateTime
        +thoiHanThue : Integer
        +yeuCauKhac : String
        +trangThai : String
        +maKH : String
        +maNV : String
        ' ---
        +timKiemPhieuDangKy(tuKhoa : String) : List<PhieuDangKy>
        +layChiTietPhieuDangKy(maPDK : String) : PhieuDangKy
    }

    class KhachHang {
        +maKH : String
        +hoTen : String
        +sdt : String
        +email : String
        +loaiGiayTo : String
        +soGiayTo : String
        +ngaySinh : DateTime
        +gioiTinh : String
        +quocTich : String
        +diaChiThuongTru : String
        ' ---
        +layThongTinKhachHang(maKH : String) : KhachHang
    }
}

' =====================
' LỚP TRUY XUẤT DỮ LIỆU
' =====================

package "Lớp truy xuất dữ liệu" #F2F3F4 {

    class PhieuDangKyDB {
        +timKiemPhieuDangKy(tuKhoa : String) : List<PhieuDangKy>
        +getPhieuDangKyTheoMaPDK(maPDK : String) : PhieuDangKy
    }

    class KhachHangDB {
        +getKhachHangTheoMaKH(maKH : String) : KhachHang
    }
}

' =====================
' QUAN HỆ
' =====================

MHTraCuuPhieuDangKy o-- PhieuDangKy
MHTraCuuPhieuDangKy o-- KhachHang

PhieuDangKy o-- PhieuDangKyDB
KhachHang   o-- KhachHangDB

@enduml